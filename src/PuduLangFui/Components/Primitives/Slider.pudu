/** @Fui.Slider.Component — a value along a range */
module PuduLangFui.Components.Primitives.Slider

import Std.Html.Build as H
import PuduLangFui.Constants.WidgetScripts as Script
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// A slider with the given name, between `minimum` and `maximum`, starting at `value`.
export fn slider(name: Str, value: Int, minimum: Int = 0, maximum: Int = 100) -> H.Node {
  let span = if maximum > minimum { maximum - minimum } else { 1 }
  let filled = (value - minimum) * 100 / span

  H.input().slot("slider").kind("range").id(name).name(name).value(show(value)).at("min", show(minimum)).at("max", show(maximum)).css("--slider-fill", show(filled) + "%")
}

/// The styles of a slider; a look sets its track and thumb through the variables here.
export fn style() -> Css.Block {
  let fill = "$primary var(--slider-fill), var(--slider-track) var(--slider-fill)"
  let thumb = "inline-size: var(--slider-thumb-width); block-size: var(--slider-thumb-height); background: var(--slider-thumb); border: var(--slider-thumb-edge); border-radius: var(--slider-thumb-radius); box-shadow: var(--slider-thumb-shadow)"

  Css.block("slider", [
      Css.base("--slider-track: $muted; --slider-track-size: $unit; --slider-track-radius: $radius-full; --slider-thumb: white; --slider-thumb-width: calc($unit * 3); --slider-thumb-height: calc($unit * 3); --slider-thumb-edge: $border-width solid $ring; --slider-thumb-radius: $radius-full; --slider-thumb-shadow: none; --slider-thumb-ring: color-mix(in oklab, $ring 50%, transparent); appearance: none; block-size: 1.25rem; margin: 0; background: transparent; cursor: pointer; outline: none"),
      Css.when("::-webkit-slider-runnable-track", "block-size: var(--slider-track-size); border-radius: var(--slider-track-radius); background: linear-gradient(to right, " + fill + ")"),
      Css.when(":dir(rtl)::-webkit-slider-runnable-track", "background: linear-gradient(to left, " + fill + ")"),
      Css.when("::-moz-range-track", "block-size: var(--slider-track-size); border-radius: var(--slider-track-radius); background: var(--slider-track)"),
      Css.when("::-moz-range-progress", "block-size: var(--slider-track-size); border-radius: var(--slider-track-radius); background: $primary"),
      Css.when("::-webkit-slider-thumb", "appearance: none; box-sizing: border-box; margin-block-start: calc((var(--slider-track-size) - var(--slider-thumb-height)) / 2); " + thumb + "; transition: box-shadow $duration-fast $ease-standard"),
      Css.when("::-moz-range-thumb", "box-sizing: border-box; " + thumb),
      Css.when(":is(:hover, :focus-visible, :active)::-webkit-slider-thumb", "box-shadow: 0 0 0 3px var(--slider-thumb-ring), var(--slider-thumb-shadow)"),
      Css.when(":is(:hover, :focus-visible, :active)::-moz-range-thumb", "box-shadow: 0 0 0 3px var(--slider-thumb-ring), var(--slider-thumb-shadow)"),
      Css.disabled("opacity: 0.5; cursor: not-allowed"),
      Css.behavior(Script.SLIDER)
    ])
}
