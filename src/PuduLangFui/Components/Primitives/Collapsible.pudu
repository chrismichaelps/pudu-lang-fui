/** @Fui.Collapsible.Component — content opened and closed natively */
module PuduLangFui.Components.Primitives.Collapsible

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// Content that opens and closes.
export fn collapsible(open: Bool = false) -> H.Node { H.details().slot("collapsible").flagIf(open, "open") }

/// The always-visible control.
export fn trigger() -> H.Node { H.summary().slot("collapsible-trigger") }

/// The content that opens.
export fn content() -> H.Node { Core.part("collapsible-content") }

/// The styles of a collapsible.
export fn style() -> Css.Block {
  Css.block("collapsible", [
      Css.base("interpolate-size: allow-keywords"),
      Css.when("::details-content", "block-size: 0; overflow: clip; transition: block-size $duration-base $ease-standard, content-visibility $duration-base allow-discrete"),
      Css.when("[open]::details-content", "block-size: auto"),
      Css.slot("collapsible-trigger", "cursor: pointer; list-style: none"),
      Css.slotWhen("collapsible-trigger", ":focus-visible", "outline: 2px solid $ring; outline-offset: 2px"),
      Css.slotWhen("collapsible-trigger", "::-webkit-details-marker", "display: none"),
      Css.slot("collapsible-content", "display: flex; flex-direction: column; gap: $space-2")
    ])
}
