/** @Fui.Accordion.Component — sections kept exclusive by the platform */
module PuduLangFui.Components.Primitives.Accordion

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// Sections stacked together.
export fn accordion() -> H.Node { Core.part("accordion") }

/// A section with a heading; sections sharing a non-empty `group` open one at a time.
export fn item(group: Str, heading: Str, open: Bool = false) -> H.Node {
  H.details().slot("accordion-item").atIf(!group.isEmpty(), "name", group).flagIf(open, "open").holding([
      H.summary().slot("accordion-trigger").says(heading)
    ])
}

/// The section's body.
export fn content() -> H.Node { Core.part("accordion-content") }

/// The styles of an accordion.
export fn style() -> Css.Block {
  Css.block("accordion", [
      Css.base("display: flex; flex-direction: column; border: $border-width solid $border; border-radius: $radius-2xl; overflow: hidden"),
      Css.slot("accordion-item", "interpolate-size: allow-keywords"),
      Css.slotWhen("accordion-item", "::details-content", "block-size: 0; overflow: clip; transition: block-size $duration-base $ease-standard, content-visibility $duration-base allow-discrete"),
      Css.slotWhen("accordion-item", "[open]::details-content", "block-size: auto"),
      Css.slot("accordion-trigger", "display: flex; align-items: center; justify-content: space-between; gap: $space-6; padding: $space-4; font-size: $text-sm; font-weight: $weight-medium; text-align: start; cursor: pointer; list-style: none"),
      Css.slotWhen("accordion-trigger", ":hover", "text-decoration: underline"),
      Css.slotWhen("accordion-trigger", ":focus-visible", "outline: 2px solid $ring; outline-offset: 2px"),
      Css.slotWhen("accordion-trigger", "::-webkit-details-marker", "display: none"),
      Css.slotWhen("accordion-trigger", "::after", "content: ''; inline-size: 0.5rem; block-size: 0.5rem; border-inline-end: 1.5px solid $muted-foreground; border-block-end: 1.5px solid $muted-foreground; rotate: 45deg; transition: rotate $duration-base $ease-standard"),
      Css.rule("[data-slot=\"accordion-item\"][open] > [data-slot=\"accordion-trigger\"]::after", "rotate: 225deg"),
      Css.slot("accordion-content", "padding-inline: $space-4; padding-block-end: $space-4; font-size: $text-sm"),
      Css.slotWhen("accordion-item", ":not(:last-child)", "border-block-end: $border-width solid $border"),
      Css.slotWhen("accordion-item", "[open]", "background: color-mix(in oklab, $muted 50%, transparent)")
    ])
}
