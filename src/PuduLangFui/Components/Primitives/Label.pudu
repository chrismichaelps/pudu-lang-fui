/** @Fui.Label.Component — names a form control */
module PuduLangFui.Components.Primitives.Label

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Core.Tree as Tree
import PuduLangFui.Domain.Css as Css

/// A label for the control with the given id, as a tree node.
export fn labelTree(control: Str) -> Tree.Tree { Tree.of(Tree.Text, H.labelFor()).at("for", control).slot("label") }

/// A label for the control with the given id.
export fn label(control: Str) -> H.Node { Tree.web(&labelTree(control)) }

/// The styles of a label.
export fn style() -> Css.Block {
  Css.block("label", [
      Css.base("display: inline-flex; align-items: center; gap: $space-2; font-size: $text-sm; font-weight: $weight-medium; line-height: 1; user-select: none"),
      Css.when(":has(+ :disabled)", "opacity: 0.5")
    ])
}
