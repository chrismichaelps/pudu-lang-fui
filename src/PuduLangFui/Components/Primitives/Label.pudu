/** @Fui.Label.Component — names a form control */
module PuduLangFui.Components.Primitives.Label

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// A label for the control with the given id.
export fn label(control: Str) -> H.Node { H.labelFor().at("for", control).slot("label") }

/// The styles of a label.
export fn style() -> Css.Block {
  Css.block("label", [
      Css.base("display: inline-flex; align-items: center; gap: $space-2; font-size: $text-sm; font-weight: $weight-medium; line-height: $leading-tight; user-select: none"),
      Css.when(":has(+ :disabled)", "opacity: 0.5")
    ])
}
