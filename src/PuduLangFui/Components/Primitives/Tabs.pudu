/** @Fui.Tabs.Component — panels switched by labelled choices */
module PuduLangFui.Components.Primitives.Tabs

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Tabs.Variant — how the row of choices is drawn */
export type Variant = Pill | Line

/** @Fui.Tabs.Tab — one choice and its panel */
export type Tab = { value: Str, caption: Str, panel: H.Node }

/// The most panels one set of tabs holds.
const MAXIMUM_PANELS: Int = 12

/// A choice and its panel.
export fn tab(value: Str, caption: Str, panel: H.Node) -> Tab { Tab{value: value, caption: caption, panel: panel} }

/// Panels switched by choices; `selected` is the value shown first.
export fn tabs(name: Str, selected: Str, items: Array[Tab], variant: Variant) -> H.Node {
  var row: Array[H.Node] = []
  var panels: Array[H.Node] = []

  for item in items {
    let id = name + "-" + item.value

    row = row.push(H.input().kind("radio").id(id).name(name).value(item.value).flagIf(item.value == selected, "checked"))
    row = row.push(H.labelFor().slot("tabs-trigger").at("for", id).says(item.caption))
    panels = panels.push(Core.part("tabs-panel").holding([item.panel]))
  }

  Core.part("tabs").data("variant", Core.spelled(variant)).holding([
      Core.part("tabs-list").role("radiogroup").label(name).holding(row)
    ].concat(panels))
}

/// The styles of tabs, with one rule per position that shows a panel.
export fn style() -> Css.Block {
  var steps: Array[Css.Step] = [
    Css.base("display: flex; flex-direction: column; gap: $space-2"),
    Css.slot("tabs-list", "display: inline-flex; align-items: center; justify-content: center; inline-size: fit-content; block-size: $control-md; padding: $space-1; background: $muted; color: $muted-foreground; border-radius: $radius-full"),
    Css.rule("[data-slot=\"tabs-list\"] > input", "position: absolute; opacity: 0; pointer-events: none"),
    Css.slot("tabs-trigger", "display: inline-flex; flex: 1; align-items: center; justify-content: center; gap: $space-2; block-size: 100%; padding: $space-1 $space-3; border-radius: $radius-full; font-size: $text-sm; font-weight: $weight-medium; white-space: nowrap; cursor: pointer; transition: color $duration-fast $ease-standard, background-color $duration-fast $ease-standard"),
    Css.slotWhen("tabs-trigger", ":hover", "color: $foreground"),
    Css.rule("[data-slot=\"tabs-list\"] > input:checked + [data-slot=\"tabs-trigger\"]", "background: $background; color: $foreground; box-shadow: $shadow-sm"),
    Css.rule("[data-slot=\"tabs-list\"] > input:focus-visible + [data-slot=\"tabs-trigger\"]", "outline: 2px solid $ring; outline-offset: 2px"),
    Css.rule("[data-slot=\"tabs\"][data-variant=\"line\"] > [data-slot=\"tabs-list\"]", "background: transparent; border-radius: 0; padding: 0; gap: $space-1"),
    Css.rule("[data-slot=\"tabs\"][data-variant=\"line\"] > [data-slot=\"tabs-list\"] > input:checked + [data-slot=\"tabs-trigger\"]", "background: transparent !important; box-shadow: inset 0 -2px 0 $foreground !important; border-radius: 0 !important"),
    Css.slot("tabs-panel", "display: none; font-size: $text-sm")
  ]
  var position = 1

  while position <= MAXIMUM_PANELS {
    let nth = show(position)

    steps = steps.push(Css.rule("[data-slot=\"tabs\"]:has(> [data-slot=\"tabs-list\"] > input:nth-of-type(" + nth + "):checked) > [data-slot=\"tabs-panel\"]:nth-of-type(" + show(position + 1) + ")", "display: block"))
    position = position + 1
  }

  Css.block("tabs", steps)
}
