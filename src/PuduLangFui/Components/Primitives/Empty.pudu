/** @Fui.Empty.Component — what a view shows when empty */
module PuduLangFui.Components.Primitives.Empty

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// An empty state.
export fn empty() -> H.Node { Core.part("empty") }

/// The icon or image of an empty state.
export fn media() -> H.Node { Core.part("empty-media") }

/// The empty state's headline.
export fn title() -> H.Node { Core.part("empty-title") }

/// What the empty state explains.
export fn description() -> H.Node { Core.part("empty-description") }

/// What a reader can do next.
export fn content() -> H.Node { Core.part("empty-content") }

/// Title and description together.
export fn header() -> H.Node { Core.part("empty-header") }

/// The styles of an empty state.
export fn style() -> Css.Block {
  Css.block("empty", [
      Css.base("display: flex; flex-direction: column; align-items: center; justify-content: center; gap: $space-4; padding: $space-12; text-align: center; text-wrap: balance; border-radius: $radius-2xl"),
      Css.slot("empty-media", "display: flex; align-items: center; justify-content: center; inline-size: $space-10; block-size: $space-10; margin-block-end: $space-2; background: $muted; border-radius: $radius-xl"),
      Css.slot("empty-title", "font-size: $text-lg; font-weight: $weight-medium; letter-spacing: $tracking"),
      Css.slot("empty-description", "max-inline-size: 24rem; font-size: $text-sm; line-height: 1.625; color: $muted-foreground"),
      Css.slot("empty-content", "display: flex; flex-direction: column; align-items: center; gap: $space-4; font-size: $text-sm"),
      Css.slot("empty-header", "display: flex; flex-direction: column; align-items: center; gap: $space-2; max-inline-size: 24rem")
    ])
}
