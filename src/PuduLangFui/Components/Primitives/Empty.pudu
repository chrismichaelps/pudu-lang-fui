/** @Fui.Empty.Component — what a view shows when empty */
module PuduLangFui.Components.Primitives.Empty

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// An empty state.
export fn empty() -> H.Node { Core.part("empty") }

/// The icon or image of an empty state.
export fn media() -> H.Node { Core.part("empty-media") }

/// The empty state's headline.
export fn title() -> H.Node { Core.part("empty-title") }

/// What the empty state explains.
export fn description() -> H.Node { Core.part("empty-description") }

/// What a reader can do next.
export fn content() -> H.Node { Core.part("empty-content") }

/// Title and description together.
export fn header() -> H.Node { Core.part("empty-header") }

/// The styles of an empty state.
export fn style() -> Css.Block {
  Css.block("empty", [
      Css.base("display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; text-wrap: balance"),
      Css.slot("empty-media", "display: flex; align-items: center; justify-content: center"),
      Css.slot("empty-title", "font-weight: $weight-medium"),
      Css.slot("empty-description", "color: $muted-foreground"),
      Css.slot("empty-content", "display: flex; flex-direction: column; align-items: center"),
      Css.slot("empty-header", "display: flex; flex-direction: column; align-items: center")
    ])
}
