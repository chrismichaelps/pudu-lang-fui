/** @Fui.Resizable.Component — panels the reader can resize */
module PuduLangFui.Components.Primitives.Resizable

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Resizable.Orientation — the axis panels divide along */
export type Orientation = Horizontal | Vertical

/// Panels dividing a space along an axis.
export fn group(orientation: Orientation) -> H.Node {
  Core.part("resizable").data("orientation", Core.spelled(orientation))
}

/// A panel starting at the given share of the space, such as `30%`.
export fn panel(share: Str) -> H.Node { Core.part("resizable-panel").css("flex-basis", share) }

/// The styles of resizable panels.
export fn style() -> Css.Block {
  Css.block("resizable", [
      Css.base("display: flex; inline-size: 100%; border: $border-width solid $border; border-radius: $radius-lg; overflow: hidden"),
      Css.variant("orientation", "vertical", "flex-direction: column"),
      Css.slot("resizable-panel", "overflow: auto; flex-shrink: 0; min-inline-size: 3rem; min-block-size: 3rem; resize: horizontal; border-inline-end: $border-width solid $border"),
      Css.slotWhen("resizable-panel", ":last-child", "flex: 1; resize: none; border: 0"),
      Css.rule("[data-slot=\"resizable\"][data-orientation=\"vertical\"] > [data-slot=\"resizable-panel\"]", "resize: vertical; border-inline-end: 0; border-block-end: $border-width solid $border")
    ])
}
