/** @Fui.Icon.Component — a built-in stroke icon set */
module PuduLangFui.Components.Primitives.Icon

import Std.Html.Build as H
import Std.Option as Option
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Icon.Glyph — every icon the set draws */
export type Glyph
  = Alert | ArrowDown | ArrowUpDown | ArrowUpRight | BadgeCheck | Bold | Bookmark | Calculator | ChevronsUpDown | CreditCard | Italic | Smile | Underline | ArrowLeft | ArrowRight | ArrowUp | Book | Bot | Calendar | Check | ChevronDown
  | ChevronLeft | ChevronRight | ChevronUp | Circle | Clock | CodeBrackets | Copy | Edit | ErrorCircle
  | External | File | Flag | Folder | Globe | Grip | Image | Info | Link | List | Menu | Minus | Moon
  | More | Paperclip | Plus | Search | Send | Settings | Spark | SpinnerArc | Star | Stop | Success | Sun
  | Terminal | Trash | User | Wrench | X

/** @Fui.Icon.Size — how large an icon sits */
export type Size = Small | Medium | Large

