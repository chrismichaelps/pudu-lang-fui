/// A glyph at the size running text and controls use.
export fn icon(glyph: Glyph) -> H.Node { sized(glyph, Medium) }

/// A glyph, hidden from assistive software, at the given size.
export fn sized(glyph: Glyph, size: Size) -> H.Node {
  let drawing = Option.unwrapOr(GLYPHS.get(Core.spelled(glyph)), "")

  H.Node{name: "svg", attributes: [("data-slot", "icon"), ("data-icon", Core.spelled(glyph)), ("data-size", Core.spelled(size)), ("viewBox", "0 0 24 24"), ("aria-hidden", "true"), ("fill", "none"), ("stroke", "currentColor"), ("stroke-linecap", "round"), ("stroke-linejoin", "round")], children: []}.raw(drawing)
}

/// The styles of an icon.
export fn style() -> Css.Block {
  Css.block("icon", [
      Css.base("inline-size: $icon-md; block-size: $icon-md; stroke-width: $icon-stroke; flex-shrink: 0"),
      Css.variant("size", "small", "inline-size: $icon-sm; block-size: $icon-sm"),
      Css.variant("size", "large", "inline-size: $icon-lg; block-size: $icon-lg")
    ])
}
