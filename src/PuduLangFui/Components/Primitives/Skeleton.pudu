/** @Fui.Skeleton.Component — a placeholder while content loads */
module PuduLangFui.Components.Primitives.Skeleton

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Core.Tree as Tree
import PuduLangFui.Domain.Css as Css

/// A placeholder, sized by the caller with `.css` or a class, as a tree node.
export fn skeletonTree() -> Tree.Tree { Tree.of(Tree.Group, H.div()).slot("skeleton").at("aria-hidden", "true") }

/// A placeholder shown while content loads.
export fn skeleton() -> H.Node { Tree.web(&skeletonTree()) }

/// The styles of a placeholder.
export fn style() -> Css.Block {
  Css.block("skeleton", [
      Css.keyframes("fui-pulse", [("50%", "opacity: 0.5")]),
      Css.base("background: $muted; border-radius: $radius-2xl; animation: fui-pulse calc($duration-slow * 6) $ease-standard infinite")
    ])
}
