/** @Fui.Switch.Component — an on and off control */
module PuduLangFui.Components.Primitives.Switch

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// A switch with the given name, identified by that name.
export fn switcher(name: Str, on: Bool = false, disabled: Bool = false) -> H.Node {
  H.input().slot("switch").kind("checkbox").role("switch").id(name).name(name).flagIf(on, "checked").flagIf(disabled, "disabled")
}

/// The styles of a switch.
export fn style() -> Css.Block {
  Css.block("switch", [
      Css.base("--switch-travel: 1rem; appearance: none; position: relative; flex-shrink: 0; inline-size: 2.75rem; block-size: 1.25rem; margin: 0; background: color-mix(in oklab, $input 90%, transparent); border: 2px solid transparent; border-radius: $radius-full; cursor: pointer; outline: none; transition: background-color $duration-base $ease-standard"),
      Css.when("::after", "content: ''; position: absolute; inset-block-start: 0; inset-inline-start: 0; inline-size: 1.5rem; block-size: 1rem; background: $background; border-radius: $radius-full; box-shadow: $shadow-sm; transition: translate $duration-base $ease-standard"),
      Css.when(":checked", "background: $primary; border-color: $primary"),
      Css.when(":checked::after", "translate: var(--switch-travel) 0"),
      Css.when(":dir(rtl)", "--switch-travel: -1rem"),
      Css.focusRing(),
      Css.disabled("opacity: 0.5; cursor: not-allowed"),
      Css.when(":focus-visible", "border-color: $ring; box-shadow: 0 0 0 3px color-mix(in oklab, $ring 30%, transparent)")
    ])
}
