/** @Fui.Chart.Component — charts as inline SVG */
module PuduLangFui.Components.Patterns.Chart

import Std.Html.Build as H
import Std.List as List
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
import PuduLangFui.Utils.Numbers as Numbers

/** @Fui.Chart.Kind — how values are drawn */
export type Kind = Bars | Lines | Areas | Donut

/** @Fui.Chart.Series — one named run of values */
export type Series = { name: Str, values: Array[Float64] }

/// The width of the drawing box.
const WIDTH: Float64 = 600.0

/// The height of the drawing box.
const HEIGHT: Float64 = 240.0

/// How many chart colors the theme has.
const SERIES_COLORS: Int = 5

/// The outer radius of a donut.
const DONUT_RADIUS: Float64 = 90.0

/// How many grid intervals a chart draws.
const GRID_LINES: Int = 4

/// The stroke width of a donut.
const DONUT_WIDTH: Float64 = 36.0

/// The renderer each kind uses.
const RENDERERS: Map[Str, fn(&Array[Series]) -> Array[H.Node]] = mapOf([
    ("bars", bars),
    ("lines", lines),
    ("areas", areas),
    ("donut", donut)
  ])

/// A named run of values.
export fn series(name: Str, values: Array[Float64]) -> Series { Series{name: name, values: values} }

/// The chart color of the series at an index.
fn colorOf(index: Int) -> Str { "var(--fui-chart-" + show((index % SERIES_COLORS) + 1) + ")" }

/// A shade for one bar of many, lightest first.
fn shadeOf(index: Int, count: Int) -> Str {
  let position = if count > 1 { index * (SERIES_COLORS - 1) / (count - 1) } else { 0 }

  colorOf(position)
}

/// The largest value across every series, one when there is nothing to scale by.
fn peakOf(all: &Array[Series]) -> Float64 {
  var peak = 0.0

  for item in all {
    for value in item.values { if value > peak { peak = value } }
  }

  if peak > 0.0 { peak } else { 1.0 }
}

/// The height a value reaches.
fn scaled(value: Float64, peak: Float64) -> Float64 { HEIGHT - value / peak * HEIGHT }

/// One bar for every value of the first series.
fn bars(all: &Array[Series]) -> Array[H.Node] {
  let first = List.first(all)

  match first {
    case None => []
    case Some(item) => {
      let peak = peakOf(all)
      let count = item.values.length()
      let slot = WIDTH / Numbers.floatOf(if count > 0 { count } else { 1 })
      var shapes: Array[H.Node] = []
      var index = 0

      for value in item.values {
        let top = scaled(value, peak)

        shapes = shapes.push(H.tag("rect").at("x", Numbers.fixed(Numbers.floatOf(index) * slot + slot * 0.15)).at("y", Numbers.fixed(top)).at("width", Numbers.fixed(slot * 0.7)).at("height", Numbers.fixed(HEIGHT - top)).at("rx", "8").at("fill", shadeOf(index, count)).holding([H.tag("title").says(item.name + ": " + show(value))]))
        index = index + 1
      }

      shapes
    }
  }
}

/// The point list of one series.
fn pointsOf(item: &Series, peak: Float64) -> Array[Str] {
  let count = item.values.length()
  let step = WIDTH / Numbers.floatOf(if count > 1 { count - 1 } else { 1 })
  var points: Array[Str] = []
  var index = 0

  for value in item.values {
    points = points.push(Numbers.fixed(Numbers.floatOf(index) * step) + "," + Numbers.fixed(scaled(value, peak)))
    index = index + 1
  }

  points
}

/// One polyline per series.
fn lines(all: &Array[Series]) -> Array[H.Node] {
  let peak = peakOf(all)
  var shapes: Array[H.Node] = []
  var index = 0

  for item in all {
    shapes = shapes.push(H.tag("polyline").at("points", pointsOf(&item, peak).join(" ")).at("fill", "none").at("stroke", colorOf(index)).at("stroke-width", "2").holding([H.tag("title").says(item.name)]))
    index = index + 1
  }

  shapes
}

/// One filled shape per series.
fn areas(all: &Array[Series]) -> Array[H.Node] {
  let peak = peakOf(all)
  var shapes: Array[H.Node] = []
  var index = 0

  for item in all {
    let closed = ["0," + Numbers.fixed(HEIGHT)].concat(pointsOf(&item, peak)).concat([Numbers.fixed(WIDTH) + "," + Numbers.fixed(HEIGHT)])

    shapes = shapes.push(H.tag("polygon").at("points", closed.join(" ")).at("fill", colorOf(index)).at("fill-opacity", "0.35").at("stroke", colorOf(index)).holding([H.tag("title").says(item.name)]))
    index = index + 1
  }

  shapes
}

/// One arc per value of the first series.
fn donut(all: &Array[Series]) -> Array[H.Node] {
  match List.first(all) {
    case None => []
    case Some(item) => {
      var total = 0.0

      for value in item.values { total = total + value }

      if total <= 0.0 { return [] }

      let circumference = 2.0 * 3.14159265 * DONUT_RADIUS
      var shapes: Array[H.Node] = []
      var offset = 0.0
      var index = 0

      for value in item.values {
        let length = value / total * circumference

        shapes = shapes.push(H.tag("circle").at("cx", Numbers.fixed(WIDTH / 2.0)).at("cy", Numbers.fixed(HEIGHT / 2.0)).at("r", Numbers.fixed(DONUT_RADIUS)).at("fill", "none").at("stroke", colorOf(index)).at("stroke-width", Numbers.fixed(DONUT_WIDTH)).at("stroke-dasharray", Numbers.fixed(length) + " " + Numbers.fixed(circumference - length)).at("stroke-dashoffset", Numbers.fixed(0.0 - offset)).holding([H.tag("title").says(show(value))]))
        offset = offset + length
        index = index + 1
      }

      shapes
    }
  }
}

/// A chart of the series, named for assistive software.
export fn chart(kind: Kind, caption: Str, all: Array[Series]) -> H.Node {
  let render = Core.picked(&RENDERERS, kind, lines)

  Core.part("chart").holding([
      H.tag("svg").slot("chart-canvas").at("viewBox", "0 0 " + Numbers.fixed(WIDTH) + " " + Numbers.fixed(HEIGHT)).role("img").label(caption).holding(render(&all)),
      legend(&all)
    ])
}

/// The names of the series, with their colors.
fn legend(all: &Array[Series]) -> H.Node {
  var entries: Array[H.Node] = []
  var index = 0

  for item in all {
    entries = entries.push(Core.inline("chart-legend-item").holding([Core.inline("chart-swatch").css("background", colorOf(index)), H.words(item.name)]))
    index = index + 1
  }

  Core.part("chart-legend").holding(entries)
}

/// Horizontal grid lines across the drawing.
fn gridLines() -> Array[H.Node] {
  var drawn: Array[H.Node] = []
  var step = 0

  while step <= GRID_LINES {
    let height = Numbers.fixed(HEIGHT * Numbers.floatOf(step) / Numbers.floatOf(GRID_LINES))

    drawn = drawn.push(H.tag("line").slot("chart-grid").at("x1", "0").at("x2", Numbers.fixed(WIDTH)).at("y1", height).at("y2", height))
    step = step + 1
  }

  drawn
}

/// Labels under the drawing.
fn axisLabels(labels: &Array[Str]) -> H.Node {
  Core.part("chart-axis").holding(labels.map(|label: Str| H.span().says(label)))
}

/// A chart with grid lines and labels under it.
export fn labelled(kind: Kind, caption: Str, labels: Array[Str], all: Array[Series]) -> H.Node {
  let render = Core.picked(&RENDERERS, kind, lines)

  Core.part("chart").holding([
      H.tag("svg").slot("chart-canvas").at("viewBox", "0 0 " + Numbers.fixed(WIDTH) + " " + Numbers.fixed(HEIGHT)).role("img").label(caption).holding(gridLines().concat(render(&all))),
      axisLabels(&labels),
      legend(&all)
    ])
}

/// The styles of a chart.
export fn style() -> Css.Block {
  Css.block("chart", [
      Css.base("display: flex; flex-direction: column; gap: $space-3"),
      Css.slot("chart-canvas", "display: block; inline-size: 100%; block-size: auto"),
      Css.slot("chart-legend", "display: flex; flex-wrap: wrap; justify-content: center; gap: $space-4; font-size: $text-xs; color: $muted-foreground"),
      Css.slot("chart-legend-item", "display: inline-flex; align-items: center; gap: $space-1"),
      Css.slot("chart-swatch", "inline-size: $space-2; block-size: $space-2; border-radius: $radius-xs"),
      Css.slot("chart-grid", "stroke: $border; stroke-width: 1; stroke-dasharray: 3 3"),
      Css.slot("chart-axis", "display: flex; justify-content: space-between; font-size: $text-xs; color: $muted-foreground")
    ])
}
