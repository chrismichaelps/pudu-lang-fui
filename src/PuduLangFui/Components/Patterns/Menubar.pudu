/** @Fui.Menubar.Component — a row of menus */
module PuduLangFui.Components.Patterns.Menubar

import Std.Html.Build as H
import PuduLangFui.Components.Composites.DropdownMenu as DropdownMenu
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// A row of menus, each placed with `menu`.
export fn menubar() -> H.Node { Core.part("menubar").role("menubar") }

/// A menu in the row: its trigger and its already-built entries.
export fn menu(id: Str, caption: Str, entries: Array[H.Node]) -> H.Node {
  H.nothing().holding([
      H.button().kind("button").slot("menubar-trigger").at("popovertarget", id).anchors(id).says(caption),
      DropdownMenu.menu(id).holding(entries)
    ])
}

/// The styles of a menubar.
export fn style() -> Css.Block {
  Css.block("menubar", [
      Css.base("display: inline-flex; align-items: center"),
      Css.slot("menubar-trigger", "display: flex; align-items: center; color: inherit; background: transparent; border: 0; font: inherit; cursor: default; outline: none")
    ])
}
