/** @Fui.InputGroup.Component — a field joined with addons */
module PuduLangFui.Components.Composites.InputGroup

import Std.Html.Build as H
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.InputGroup.Align — which end an addon sits at */
export type Align = Start | End | BlockStart | BlockEnd

/// A joined group.
export fn group() -> H.Node { Core.part("input-group").role("group") }

/// A joined group holding a multi-line field and addons above or below it.
export fn stacked() -> H.Node { group().data("multiline", "true") }

/// A field inside the group, with the given name.
export fn input(name: Str, kind: Str = "text") -> H.Node { H.input().slot("input-group-control").id(name).name(name).kind(kind) }

/// Text, an icon, or a button joined to the field.
export fn addon(align: Align) -> H.Node { Core.part("input-group-addon").data("align", Core.spelled(align)) }

/// A multi-line field inside the group, with the given name.
export fn textarea(name: Str) -> H.Node { H.textarea().slot("input-group-textarea").id(name).name(name) }

/// The styles of a group.
export fn style() -> Css.Block {
  Css.block("input-group", [
      Css.base("display: flex; align-items: center; inline-size: 100%; block-size: $control-md; background: color-mix(in oklab, $input 50%, transparent); border: $border-width solid transparent; border-radius: $radius-4xl"),
      Css.when(":focus-within", "border-color: $ring; box-shadow: 0 0 0 3px color-mix(in oklab, $ring 30%, transparent)"),
      Css.slot("input-group-control", "flex: 1; min-inline-size: 0; block-size: 100%; padding-inline: $space-3; background: transparent; color: $foreground; border: 0; font: inherit; font-size: $text-sm; outline: none"),
      Css.slot("input-group-addon", "display: flex; align-items: center; gap: $space-2; padding-block: $space-2; padding-inline: $space-3; color: $muted-foreground; font-size: $text-sm; font-weight: $weight-medium"),
      Css.slotWhen("input-group-addon", "[data-align=\"end\"]", "order: 1"),
      Css.variant("multiline", "true", "flex-direction: column; align-items: stretch; block-size: auto"),
      Css.slot("input-group-textarea", "flex: 1; padding: $space-2 $space-3; background: transparent; color: $foreground; border: 0; font: inherit; font-size: $text-sm; outline: none; resize: none; field-sizing: content"),
      Css.slotWhen("input-group-addon", "[data-align=\"block-end\"]", "order: 1; padding-block: $space-2"),
      Css.slotWhen("input-group-addon", "[data-align=\"block-start\"]", "padding-block: $space-2")
    ])
}
