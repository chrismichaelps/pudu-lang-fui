/** @Fui.Toast.Component — stacked messages outside the flow */
module PuduLangFui.Components.Composites.Toast

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Constants.ToastScript as Script
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Toast.Kind — what a toast reports */
export type Kind = Neutral | Success | Info | Warning | Failure | Loading

/** @Fui.Toast.Position — which corner or edge toasts collect at */
export type Position = TopStart | TopCenter | TopEnd | BottomStart | BottomCenter | BottomEnd

/** @Fui.Toast.Mode — which color mode a region uses */
export type Mode = Light | Dark | System

/** @Fui.Toast.Props — how a region behaves */
export type Props = {
  position: Position,
  expanded: Bool,
  rich: Bool,
  closable: Bool,
  inverted: Bool,
  mode: Mode,
  visible: Int,
  duration: Int,
  gap: Int,
  offset: Str,
  mobileOffset: Str,
  hotkey: Array[Str],
  swipes: Array[Str],
  caption: Str,
  toaster: Str
}

/** @Fui.Toast.Notice — how one toast behaves */
export type Notice = { kind: Kind, duration: Int, dismissible: Bool, inverted: Bool, rich: Option[Bool] }

/// The icon each kind shows.
const GLYPHS: Map[Str, Icon.Glyph] = mapOf([
    ("neutral", Icon.Spark),
    ("success", Icon.Success),
    ("info", Icon.Info),
    ("warning", Icon.Alert),
    ("failure", Icon.ErrorCircle),
    ("loading", Icon.SpinnerArc)
  ])

/// Every kind whose icon a script-created toast can show, by its markup name.
const KINDS: Array[Kind] = [Neutral, Success, Info, Warning, Failure, Loading]

/// A bottom-end region showing three at a time, closing toasts after four seconds.
export fn props() -> Props {
  Props {
    position: BottomEnd,
    expanded: false,
    rich: false,
    closable: false,
    inverted: false,
    mode: System,
    visible: 3,
    duration: 4000,
    gap: 14,
    offset: "24px",
    mobileOffset: "16px",
    hotkey: ["altKey", "KeyT"],
    swipes: [],
    caption: "Notifications",
    toaster: ""
  }
}

/// A neutral toast using the region's duration, which a person can dismiss.
export fn notice() -> Notice { Notice{kind: Neutral, duration: -1, dismissible: true, inverted: false, rich: None} }

/** @Fui.Toast.Configuring — one method per prop */
export trait Configuring {
  /// Sets where toasts collect.
  fn position(self: &Self, value: Position) -> Self

  /// Keeps the stack fanned out.
  fn expanded(self: &Self) -> Self

  /// Colors toasts by kind.
  fn rich(self: &Self) -> Self

  /// Shows a close control on every toast.
  fn closable(self: &Self) -> Self

  /// Draws every toast in the opposite mode.
  fn inverted(self: &Self) -> Self

  /// Forces a color mode for the region.
  fn mode(self: &Self, value: Mode) -> Self

  /// Sets how many toasts show at once.
  fn visible(self: &Self, count: Int) -> Self

  /// Sets the default milliseconds before a toast closes.
  fn duration(self: &Self, value: Int) -> Self

  /// Sets the pixels between expanded toasts.
  fn gap(self: &Self, value: Int) -> Self

  /// Sets the distance from the window's edge.
  fn offset(self: &Self, value: Str) -> Self

  /// Sets the distance from the edge on small screens.
  fn mobileOffset(self: &Self, value: Str) -> Self

  /// Sets the keys that focus the region, as event properties and codes.
  fn hotkey(self: &Self, value: Array[Str]) -> Self

  /// Sets the directions a toast can be swiped: `top`, `bottom`, `left`, `right`.
  fn swipes(self: &Self, value: Array[Str]) -> Self

  /// Sets the region's name for assistive software.
  fn caption(self: &Self, value: Str) -> Self

  /// Names this region, so a script can send toasts to it alone.
  fn toaster(self: &Self, value: Str) -> Self
}

impl Configuring for Props {
  fn position(self: &Self, value: Position) -> Self { Props{..*self, position: value} }

  fn expanded(self: &Self) -> Self { Props{..*self, expanded: true} }

  fn rich(self: &Self) -> Self { Props{..*self, rich: true} }

  fn closable(self: &Self) -> Self { Props{..*self, closable: true} }

  fn inverted(self: &Self) -> Self { Props{..*self, inverted: true} }

  fn mode(self: &Self, value: Mode) -> Self { Props{..*self, mode: value} }

  fn visible(self: &Self, count: Int) -> Self { Props{..*self, visible: count} }

  fn duration(self: &Self, value: Int) -> Self { Props{..*self, duration: value} }

  fn gap(self: &Self, value: Int) -> Self { Props{..*self, gap: value} }

  fn offset(self: &Self, value: Str) -> Self { Props{..*self, offset: value} }

  fn mobileOffset(self: &Self, value: Str) -> Self { Props{..*self, mobileOffset: value} }

  fn hotkey(self: &Self, value: Array[Str]) -> Self { Props{..*self, hotkey: value} }

  fn swipes(self: &Self, value: Array[Str]) -> Self { Props{..*self, swipes: value} }

  fn caption(self: &Self, value: Str) -> Self { Props{..*self, caption: value} }

  fn toaster(self: &Self, value: Str) -> Self { Props{..*self, toaster: value} }
}

/** @Fui.Toast.Noticing — one method per notice prop */
export trait Noticing {
  /// Sets what the toast reports.
  fn kind(self: &Self, value: Kind) -> Self

  /// Sets the milliseconds before it closes; zero keeps it open.
  fn duration(self: &Self, value: Int) -> Self

  /// Prevents swiping it away.
  fn persistent(self: &Self) -> Self

  /// Draws it in the opposite mode.
  fn inverted(self: &Self) -> Self

  /// Colors or plain-colors this toast whatever the region says.
  fn rich(self: &Self, value: Bool) -> Self
}

impl Noticing for Notice {
  fn kind(self: &Self, value: Kind) -> Self { Notice{..*self, kind: value} }

  fn duration(self: &Self, value: Int) -> Self { Notice{..*self, duration: value} }

  fn persistent(self: &Self) -> Self { Notice{..*self, dismissible: false} }

  fn inverted(self: &Self) -> Self { Notice{..*self, inverted: true} }

  fn rich(self: &Self, value: Bool) -> Self { Notice{..*self, rich: Some(value)} }
}

/// The attributes a region's script and rules read.
fn regionAttributes(given: &Props) -> Array[(Str, Str)] {
  [
    ("data-slot", "toast-region"),
    ("role", "region"),
    ("aria-label", given.caption + " alt+T"),
    ("aria-live", "polite"),
    ("aria-relevant", "additions text"),
    ("aria-atomic", "false"),
    ("tabindex", "-1"),
    ("data-position", Core.spelled(given.position)),
    ("data-expand", show(given.expanded)),
    ("data-rich", show(given.rich)),
    ("data-closable", show(given.closable)),
    ("data-inverted", show(given.inverted)),
    ("data-mode", Core.spelled(given.mode)),
    ("data-visible", show(given.visible)),
    ("data-duration", show(given.duration)),
    ("data-gap", show(given.gap)),
    ("data-hotkey", given.hotkey.join(",")),
    ("data-swipe", given.swipes.join(",")),
    ("data-toaster", given.toaster),
    ("style", "--toast-offset: " + given.offset + "; --toast-mobile-offset: " + given.mobileOffset)
  ]
}

/// One icon held for script-created toasts of a kind.
fn glyphTemplate(kind: Kind) -> H.Node {
  H.tag("template").at("data-glyph", Core.spelled(kind)).holding([Icon.icon(Core.picked(&GLYPHS, kind, Icon.Spark))])
}

/// The shape a script-created toast is cloned from.
fn template() -> H.Node {
  H.tag("template").slot("toast-template").holding([
      H.dialog().slot("toast").flag("open").role("status").at("tabindex", "0").holding([
          Core.part("toast-icon"),
          Core.part("toast-content").holding([message(), description()])
        ])
    ])
}

/// The region toasts collect in, with what its script clones new ones from.
export fn toaster(given: Props) -> H.Node {
  H.Node{name: "section", attributes: regionAttributes(&given), children: []}.holding([template()].concat(KINDS.map(|kind: Kind| glyphTemplate(kind))))
}

/// The kind and timing attributes of a toast.
fn noticeAttributes(id: Str, given: &Notice) -> Array[(Str, Str)] {
  let rich = match given.rich {
    case Some(value) => [("data-rich", show(value))]
    case None => []
  }

  [
    ("data-slot", "toast"),
    ("id", id),
    ("open", "open"),
    ("role", if given.kind == Failure { "alert" } else { "status" }),
    ("tabindex", "0"),
    ("data-kind", Core.spelled(given.kind)),
    ("data-dismissible", show(given.dismissible)),
    ("data-inverted", show(given.inverted))
  ].concat(rich).concat(if given.duration >= 0 { [("data-duration", show(given.duration))] } else { [] })
}

/// A toast shown as rendered, its icon in place.
export fn toast(id: Str, given: Notice) -> H.Node {
  H.Node{name: "dialog", attributes: noticeAttributes(id, &given), children: []}.holding([
      Core.part("toast-icon").holding([Icon.icon(Core.picked(&GLYPHS, given.kind, Icon.Spark))])
    ])
}

/// The toast's text, holding its message and description.
export fn content() -> H.Node { Core.part("toast-content") }

/// The toast's message.
export fn message() -> H.Node { Core.part("toast-message") }

/// Further detail.
export fn description() -> H.Node { Core.part("toast-description") }

/// A control doing what the toast offers; it submits whatever form holds it.
export fn action() -> H.Node { H.button().slot("toast-action").kind("submit") }

/// A control declining what the toast offers.
export fn cancel(id: Str) -> H.Node {
  H.button().kind("button").slot("toast-cancel").at("commandfor", id).at("command", "close")
}

/// A control closing the toast `id`.
export fn close(id: Str) -> H.Node {
  H.button().kind("button").slot("toast-close").label("Close toast").at("commandfor", id).at("command", "close").holding([Icon.sized(Icon.X, Icon.Small)])
}

/// The styles of toasts.
export fn style() -> Css.Block {
  Css.block("toast-region", [
      Css.behavior(Script.LINES.join("\n")),
      Css.keyframes("fui-toast-spin", [("to", "rotate: 360deg")]),
      Css.keyframes("fui-toast-out-left", [("to", "transform: var(--y) translateX(calc(var(--swipe-amount-x) - 100%)); opacity: 0")]),
      Css.keyframes("fui-toast-out-right", [("to", "transform: var(--y) translateX(calc(var(--swipe-amount-x) + 100%)); opacity: 0")]),
      Css.keyframes("fui-toast-out-up", [("to", "transform: var(--y) translateY(calc(var(--swipe-amount-y) - 100%)); opacity: 0")]),
      Css.keyframes("fui-toast-out-down", [("to", "transform: var(--y) translateY(calc(var(--swipe-amount-y) + 100%)); opacity: 0")]),
      Css.base("--toast-width: 356px; --toast-normal-bg: $popover; --toast-normal-text: $popover-foreground; --toast-normal-border: $border; position: fixed; z-index: 2147483000; display: flex; flex-direction: column; gap: calc(var(--toast-gap, 14px)); inline-size: var(--toast-width); max-inline-size: calc(100vw - 32px); margin: 0; padding: 0; outline: none"),
      Css.when("[data-managed=\"true\"]", "display: block; block-size: var(--stack-height, 0)"),
      Css.when("[data-mode=\"light\"]", "color-scheme: light"),
      Css.when("[data-mode=\"dark\"]", "color-scheme: dark"),
      Css.variant("position", "bottom-end", "inset-block-end: var(--toast-offset); inset-inline-end: var(--toast-offset)"),
      Css.variant("position", "bottom-start", "inset-block-end: var(--toast-offset); inset-inline-start: var(--toast-offset)"),
      Css.variant("position", "bottom-center", "inset-block-end: var(--toast-offset); inset-inline-start: 50%; translate: -50% 0"),
      Css.variant("position", "top-end", "inset-block-start: var(--toast-offset); inset-inline-end: var(--toast-offset)"),
      Css.variant("position", "top-start", "inset-block-start: var(--toast-offset); inset-inline-start: var(--toast-offset)"),
      Css.variant("position", "top-center", "inset-block-start: var(--toast-offset); inset-inline-start: 50%; translate: -50% 0"),
      Css.within("@media (max-width: 600px)", "[data-slot=\"toast-region\"]", "inset-inline: var(--toast-mobile-offset); inline-size: auto; translate: none"),
      Css.slot("toast", "--y: translateY(0); --lift: -1; position: relative; display: flex; align-items: center; gap: 6px; box-sizing: border-box; margin: 0; padding: 16px; inline-size: 100%; background: var(--toast-normal-bg); color: var(--toast-normal-text); border: $border-width solid var(--toast-normal-border); border-radius: $radius; box-shadow: 0 4px 12px oklch(0 0 0 / 0.1); font-size: 13px; overflow-wrap: anywhere; outline: none; touch-action: none"),
      Css.slotWhen("toast", ":not([open])", "display: none"),
      Css.slotWhen("toast", ":focus-visible", "box-shadow: 0 4px 12px oklch(0 0 0 / 0.1), 0 0 0 2px oklch(0 0 0 / 0.2)"),
      Css.slotWhen("toast", "[data-inverted=\"true\"]", "--toast-normal-bg: $foreground; --toast-normal-text: $background; --toast-normal-border: $foreground"),
      Css.rule("[data-slot=\"toast-region\"][data-inverted=\"true\"] [data-slot=\"toast\"]", "--toast-normal-bg: $foreground; --toast-normal-text: $background; --toast-normal-border: $foreground"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"]", "--y: translateY(100%); --lift-amount: calc(var(--lift) * var(--toast-gap)); position: absolute; z-index: var(--z-index); opacity: 0; transform: var(--y); transition: transform 400ms, opacity 400ms, height 400ms, box-shadow 200ms"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"][data-position^=\"bottom\"] [data-slot=\"toast\"]", "inset-block-end: 0"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"][data-position^=\"top\"] [data-slot=\"toast\"]", "--y: translateY(-100%); --lift: 1; --lift-amount: var(--toast-gap); inset-block-start: 0"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-mounted=\"true\"]", "--y: translateY(0); opacity: 1"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-expanded=\"false\"][data-front=\"false\"]", "--scale: var(--toasts-before) * 0.05 + 1; --y: translateY(calc(var(--lift-amount) * var(--toasts-before))) scale(calc(-1 * var(--scale))); height: var(--front-toast-height)"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-expanded=\"false\"][data-front=\"false\"] > *", "opacity: 0"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"] > *", "transition: opacity 400ms"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-visible=\"false\"]", "opacity: 0; pointer-events: none"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-mounted=\"true\"][data-expanded=\"true\"]", "--y: translateY(calc(var(--lift) * var(--offset))); height: var(--initial-height)"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-expanded=\"true\"]::after", "content: ''; position: absolute; inset-inline: 0; inset-block-end: 100%; block-size: calc(var(--toast-gap) + 1px)"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-removed=\"true\"]:not([data-swipe-out=\"true\"])", "--y: translateY(calc(var(--lift) * -100%)); opacity: 0"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-removed=\"true\"][data-front=\"false\"][data-expanded=\"false\"]:not([data-swipe-out=\"true\"])", "--y: translateY(40%); opacity: 0; transition: transform 500ms, opacity 200ms"),
      Css.rule("[data-slot=\"toast-region\"][data-managed=\"true\"] [data-slot=\"toast\"][data-swiping=\"true\"]", "transform: var(--y) translateY(var(--swipe-amount-y, 0px)) translateX(var(--swipe-amount-x, 0px)); transition: none"),
      Css.rule("[data-slot=\"toast\"][data-swiped=\"true\"]", "user-select: none"),
      Css.rule("[data-slot=\"toast\"][data-swipe-out=\"true\"]", "animation-duration: 200ms; animation-timing-function: ease-out; animation-fill-mode: forwards"),
      Css.rule("[data-slot=\"toast\"][data-swipe-out=\"true\"][data-swipe-direction=\"left\"]", "animation-name: fui-toast-out-left"),
      Css.rule("[data-slot=\"toast\"][data-swipe-out=\"true\"][data-swipe-direction=\"right\"]", "animation-name: fui-toast-out-right"),
      Css.rule("[data-slot=\"toast\"][data-swipe-out=\"true\"][data-swipe-direction=\"up\"]", "animation-name: fui-toast-out-up"),
      Css.rule("[data-slot=\"toast\"][data-swipe-out=\"true\"][data-swipe-direction=\"down\"]", "animation-name: fui-toast-out-down"),
      Css.rule("[data-slot=\"toast\"][data-kind=\"success\"]:is([data-rich=\"true\"]), [data-slot=\"toast-region\"][data-rich=\"true\"] [data-slot=\"toast\"][data-kind=\"success\"]:not([data-rich=\"false\"])", "--toast-normal-bg: light-dark(hsl(143 85% 96%), hsl(150 100% 6%)); --toast-normal-border: light-dark(hsl(145 92% 87%), hsl(147 100% 12%)); --toast-normal-text: light-dark(hsl(140 100% 27%), hsl(150 86% 65%))"),
      Css.rule("[data-slot=\"toast\"][data-kind=\"info\"]:is([data-rich=\"true\"]), [data-slot=\"toast-region\"][data-rich=\"true\"] [data-slot=\"toast\"][data-kind=\"info\"]:not([data-rich=\"false\"])", "--toast-normal-bg: light-dark(hsl(208 100% 97%), hsl(215 100% 6%)); --toast-normal-border: light-dark(hsl(221 91% 93%), hsl(223 43% 17%)); --toast-normal-text: light-dark(hsl(210 92% 45%), hsl(216 87% 65%))"),
      Css.rule("[data-slot=\"toast\"][data-kind=\"warning\"]:is([data-rich=\"true\"]), [data-slot=\"toast-region\"][data-rich=\"true\"] [data-slot=\"toast\"][data-kind=\"warning\"]:not([data-rich=\"false\"])", "--toast-normal-bg: light-dark(hsl(49 100% 97%), hsl(64 100% 6%)); --toast-normal-border: light-dark(hsl(49 91% 84%), hsl(60 100% 9%)); --toast-normal-text: light-dark(hsl(31 92% 45%), hsl(46 87% 65%))"),
      Css.rule("[data-slot=\"toast\"][data-kind=\"failure\"]:is([data-rich=\"true\"]), [data-slot=\"toast-region\"][data-rich=\"true\"] [data-slot=\"toast\"][data-kind=\"failure\"]:not([data-rich=\"false\"])", "--toast-normal-bg: light-dark(hsl(359 100% 97%), hsl(358 76% 10%)); --toast-normal-border: light-dark(hsl(359 100% 94%), hsl(357 89% 16%)); --toast-normal-text: light-dark(hsl(360 100% 45%), hsl(358 100% 81%))"),
      Css.slot("toast-template", "display: none"),
      Css.slot("toast-icon", "display: flex; flex-shrink: 0; align-items: center; justify-content: flex-start; inline-size: 16px; block-size: 16px; margin-inline: -3px 4px"),
      Css.rule("[data-slot=\"toast\"][data-kind=\"loading\"] [data-slot=\"toast-icon\"] > [data-slot=\"icon\"]", "animation: fui-toast-spin 800ms linear infinite"),
      Css.slot("toast-content", "display: flex; flex: 1; flex-direction: column; gap: 2px; min-inline-size: 0"),
      Css.slot("toast-message", "font-weight: $weight-medium; line-height: 1.5; color: inherit"),
      Css.slot("toast-description", "font-weight: $weight-normal; line-height: 1.4; color: $muted-foreground"),
      Css.slot("toast-action", "display: flex; flex-shrink: 0; align-items: center; block-size: 24px; margin-inline-start: auto; padding-inline: 8px; background: var(--toast-normal-text); color: var(--toast-normal-bg); border: 0; border-radius: 4px; font-size: 12px; font-weight: $weight-medium; cursor: pointer; outline: none; transition: opacity 400ms, box-shadow 200ms"),
      Css.slot("toast-cancel", "display: flex; flex-shrink: 0; align-items: center; block-size: 24px; margin-inline-start: auto; padding-inline: 8px; background: light-dark(oklch(0 0 0 / 0.08), oklch(1 0 0 / 0.3)); color: var(--toast-normal-text); border: 0; border-radius: 4px; font-size: 12px; font-weight: $weight-medium; cursor: pointer; outline: none"),
      Css.slot("toast-close", "position: absolute; inset-block-start: 0; inset-inline-start: 0; z-index: 1; display: flex; align-items: center; justify-content: center; inline-size: 20px; block-size: 20px; padding: 0; background: var(--toast-normal-bg); color: var(--toast-normal-text); border: $border-width solid var(--toast-normal-border); border-radius: 50%; translate: -35% -35%; cursor: pointer; transition: opacity 100ms, background-color 200ms, border-color 200ms"),
      Css.rule(":dir(rtl) [data-slot=\"toast-close\"]", "translate: 35% -35%"),
      Css.slotWhen("toast-close", ":hover", "background: $muted; border-color: $border"),
      Css.slotWhen("toast-close", " svg", "inline-size: 12px; block-size: 12px")
    ])
}
