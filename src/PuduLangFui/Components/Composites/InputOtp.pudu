/** @Fui.InputOtp.Component — a one-time code entered across cells */
module PuduLangFui.Components.Composites.InputOtp

import Std.Html.Build as H
import PuduLangFui.Constants.WidgetScripts as Script
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// One cell of the code, holding a character and the caret.
fn cell() -> H.Node {
  Core.part("input-otp-slot").holding([H.span(), Core.part("input-otp-caret").holding([Core.part("input-otp-caret-line")])])
}

/// A code field of the given length, reading digits; one field carries the value.
export fn inputOtp(name: Str, length: Int = 6, value: Str = "") -> H.Node {
  var cells: Array[H.Node] = []
  var index = 0

  while index < length {
    cells = cells.push(cell())
    index = index + 1
  }

  Core.part("input-otp").holding([
      H.input().slot("input-otp-input").id(name).name(name).value(value).at("inputmode", "numeric").at("autocomplete", "one-time-code").at("maxlength", show(length)).at("pattern", "[0-9]*").label("One-time code"),
      Core.part("input-otp-group").holding(cells)
    ])
}

/// The styles of a code field.
export fn style() -> Css.Block {
  Css.block("input-otp", [
      Css.base("position: relative; inline-size: fit-content"),
      Css.slot("input-otp-input", "position: absolute; inset: 0; z-index: 1; inline-size: 100%; block-size: 100%; margin: 0; padding: 0; border: 0; color: transparent; caret-color: transparent; background: transparent; outline: none; font-size: 16px; letter-spacing: 2ch"),
      Css.rule("[data-slot=\"input-otp-slot\"]:not([data-caret]) > [data-slot=\"input-otp-caret\"]", "display: none !important"),
      Css.behavior(Script.OTP)
    ])
}
