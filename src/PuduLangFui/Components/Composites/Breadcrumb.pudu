/** @Fui.Breadcrumb.Component — where a page sits */
module PuduLangFui.Components.Composites.Breadcrumb

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Breadcrumb.Crumb — one step in the trail */
export type Crumb = { caption: Str, target: Str }

/// A step that links.
export fn crumb(caption: Str, target: Str) -> Crumb { Crumb{caption: caption, target: target} }

/// A step standing for hidden steps.
export fn collapsed() -> Crumb { Crumb{caption: "", target: ""} }

/// One step, drawn as text when it is the page itself.
fn step(item: &Crumb, isLast: Bool) -> H.Node {
  if item.caption.isEmpty() { return ellipsis() }

  if isLast { return H.span().slot("breadcrumb-page").at("aria-current", "page").says(item.caption) }

  H.a().slot("breadcrumb-link").href(item.target).says(item.caption)
}

/// A trail ending at the current page.
export fn breadcrumb(trail: &Array[Crumb]) -> H.Node {
  var entries: Array[H.Node] = []
  var index = 0

  for item in trail {
    let isLast = index == trail.length() - 1

    entries = entries.push(H.li().slot("breadcrumb-item").holding([step(&item, isLast)]))

    if !isLast {
      entries = entries.push(H.li().slot("breadcrumb-separator").at("aria-hidden", "true").holding([Icon.sized(Icon.ChevronRight, Icon.Small)]))
    }

    index = index + 1
  }

  H.nav().slot("breadcrumb").label("Breadcrumb").holding([H.ol().slot("breadcrumb-list").holding(entries)])
}

/// A step standing for hidden steps.
export fn ellipsis() -> H.Node { H.span().slot("breadcrumb-ellipsis").label("More").holding([Icon.sized(Icon.More, Icon.Small)]) }

/// The styles of a breadcrumb.
export fn style() -> Css.Block {
  Css.block("breadcrumb", [
      Css.base("font-size: $text-sm"),
      Css.slot("breadcrumb-list", "display: flex; flex-wrap: wrap; align-items: center; margin: 0; padding: 0; list-style: none; color: $muted-foreground"),
      Css.slot("breadcrumb-item", "display: inline-flex; align-items: center"),
      Css.slot("breadcrumb-link", "color: inherit; text-decoration: none; transition: color $duration-fast $ease-standard"),
      Css.slotWhen("breadcrumb-link", ":hover", "color: $foreground"),
      Css.slot("breadcrumb-page", "color: $foreground"),
      Css.slot("breadcrumb-separator", "display: inline-flex"),
      Css.rule(":dir(rtl) [data-slot=\"breadcrumb-separator\"]", "scale: -1 1"),
      Css.slot("breadcrumb-ellipsis", "display: inline-flex; align-items: center; justify-content: center")
    ])
}
