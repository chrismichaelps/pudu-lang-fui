/** @Fui.Calendar.Component — a month as links */
module PuduLangFui.Components.Composites.Calendar

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Button as Button
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Constants.Calendar as Names
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Calendar.Date — a day of the calendar */
export type Date = { year: Int, month: Int, day: Int }

/** @Fui.Calendar.Props — what a month shows */
export type Props = { today: Option[Date], selected: Option[Date], monthNames: Array[Str], weekdayNames: Array[Str] }

/// No day marked, in English.
export fn props() -> Props { Props{today: None, selected: None, monthNames: Names.MONTHS, weekdayNames: Names.WEEKDAYS} }

/** @Fui.Calendar.Configuring — one method per prop */
export trait Configuring {
  /// Marks today.
  fn today(self: &Self, value: Date) -> Self

  /// Marks the chosen day.
  fn selected(self: &Self, value: Date) -> Self

  /// Replaces the month and weekday names.
  fn names(self: &Self, months: Array[Str], weekdays: Array[Str]) -> Self
}

impl Configuring for Props {
  fn today(self: &Self, value: Date) -> Self { Props{..*self, today: Some(value)} }

  fn selected(self: &Self, value: Date) -> Self { Props{..*self, selected: Some(value)} }

  fn names(self: &Self, months: Array[Str], weekdays: Array[Str]) -> Self { Props{..*self, monthNames: months, weekdayNames: weekdays} }
}

/// A date from its parts.
export fn date(year: Int, month: Int, day: Int) -> Date { Date{year: year, month: month, day: day} }

/// Whether a year has a leap day.
export fn isLeap(year: Int) -> Bool { year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) }

/// How many days a month has.
export fn daysIn(year: Int, month: Int) -> Int {
  if month == 2 && isLeap(year) { 29 } else { Names.MONTH_LENGTHS[month - 1] }
}

/// The weekday of a date, Sunday as zero.
export fn weekdayOf(year: Int, month: Int, day: Int) -> Int {
  let shifted = if month <= 2 { year - 1 } else { year }
  let era = (if shifted >= 0 { shifted } else { shifted - 399 }) / 400
  let yearOfEra = shifted - era * 400
  let monthFromMarch = if month > 2 { month - 3 } else { month + 9 }
  let dayOfYear = (153 * monthFromMarch + 2) / 5 + day - 1
  let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
  let days = era * 146097 + dayOfEra - Names.EPOCH_OFFSET

  (((days + Names.EPOCH_WEEKDAY) % 7) + 7) % 7
}

/// The month before a year and month.
fn previousMonth(year: Int, month: Int) -> (Int, Int) { if month == 1 { (year - 1, 12) } else { (year, month - 1) } }

/// The month after a year and month.
fn nextMonth(year: Int, month: Int) -> (Int, Int) { if month == 12 { (year + 1, 1) } else { (year, month + 1) } }

/// One day's cell.
fn dayCell(day: Date, given: &Props, linkTo: fn(Date) -> Str) -> H.Node {
  H.td().slot("calendar-cell").holding([
      H.a().slot("calendar-day").href(linkTo(day)).says(show(day.day))
        .atIf(given.today == Some(day), "aria-current", "date")
        .atIf(given.selected == Some(day), "data-selected", "true")
    ])
}

/// The rows of a month, padded before its first day.
fn weeks(year: Int, month: Int, given: &Props, linkTo: fn(Date) -> Str) -> Array[H.Node] {
  let lead = weekdayOf(year, month, 1)
  var rows: Array[H.Node] = []
  var row: Array[H.Node] = []
  var blank = 0

  while blank < lead {
    row = row.push(H.td().slot("calendar-cell"))
    blank = blank + 1
  }

  var day = 1

  while day <= daysIn(year, month) {
    row = row.push(dayCell(date(year, month, day), given, linkTo))

    if row.length() == 7 {
      rows = rows.push(H.tr().holding(row))
      row = []
    }

    day = day + 1
  }

  if row.isEmpty() { rows } else { rows.push(H.tr().holding(row)) }
}

/// A month whose days link through `linkTo` and whose arrows link through `monthLink`.
export fn calendar(year: Int, number: Int, linkTo: fn(Date) -> Str, monthLink: fn(Int, Int) -> Str, given: Props) -> H.Node {
  let (backYear, backMonth) = previousMonth(year, number)
  let (forwardYear, forwardMonth) = nextMonth(year, number)
  let arrow = Button.props().variant(Button.Ghost).size(Button.IconSmall)

  Core.part("calendar").holding([
      Core.part("calendar-header").holding([
          Button.link(monthLink(backYear, backMonth), arrow).label("Previous month").holding([Icon.icon(Icon.ChevronLeft)]),
          Core.part("calendar-title").says(given.monthNames[number - 1] + " " + show(year)),
          Button.link(monthLink(forwardYear, forwardMonth), arrow).label("Next month").holding([Icon.icon(Icon.ChevronRight)])
        ]),
      H.table().slot("calendar-grid").holding([
          H.thead().holding([H.tr().holding(given.weekdayNames.map(|name: Str| H.th().slot("calendar-weekday").at("scope", "col").says(name)))]),
          H.tbody().holding(weeks(year, number, &given, linkTo))
        ])
    ])
}

/// The styles of a calendar.
export fn style() -> Css.Block {
  Css.block("calendar", [
      Css.base("display: inline-flex; flex-direction: column; gap: $space-2; padding: $space-3"),
      Css.slot("calendar-header", "display: flex; align-items: center; justify-content: space-between"),
      Css.slot("calendar-title", "font-size: $text-sm; font-weight: $weight-medium"),
      Css.slot("calendar-grid", "border-collapse: collapse"),
      Css.slot("calendar-weekday", "inline-size: $control-sm; padding-block-end: $space-1; font-size: $text-xs; font-weight: $weight-normal; color: $muted-foreground"),
      Css.slot("calendar-cell", "padding: 0; text-align: center"),
      Css.slot("calendar-day", "display: inline-flex; align-items: center; justify-content: center; inline-size: $control-sm; block-size: $control-sm; color: inherit; border-radius: $radius-4xl; font-size: $text-sm; text-decoration: none"),
      Css.slotWhen("calendar-day", ":hover", "background: $accent; color: $accent-foreground"),
      Css.slotWhen("calendar-day", ":focus-visible", "outline: 2px solid $ring; outline-offset: 1px"),
      Css.slotWhen("calendar-day", "[aria-current=\"date\"]", "background: $muted; font-weight: $weight-semibold"),
      Css.slotWhen("calendar-day", "[data-selected=\"true\"]", "background: $primary; color: $primary-foreground")
    ])
}
