/** @Fui.Cli.Commands.Doctor.Command — audits a project */
module PuduLangFui.Cli.Commands.Doctor

import Std.Io as Io
import Std.Result as Result
import Std.Set as Set
import PuduLangFui.Cli.Commands.Context as Context
import PuduLangFui.Cli.Model.Audit as Audit
import PuduLangFui.Cli.Model.Outcome as Outcome
import PuduLangFui.Cli.Workspace.Project as Project
import PuduLangFui.Theme.Audit.Contrast as Contrast
import PuduLangFui.Theme.Build.Theme as Theme
import PuduLangFui.Theme.Presets.Design as Design

/// Every token the default theme names.
fn knownTokens() -> Set[Str] { setOf(Theme.tokens(&Theme.defaults()).map(|entry: (Str, Str)| entry[0])) }

/// What the contrast audit finds in the project's preset.
fn contrastProblems(preset: Str) -> Array[Str] {
  match Design.themeFor(preset) {
    case Err(problem) => ["preset: " + problem]
    case Ok(found) => Contrast.audit(&found.color).map(|finding: Contrast.Finding| "contrast: " + finding.pairing + " in " + finding.mode + " mode is " + show(finding.ratio))
  }
}

/// Reports every problem, failing when any was found.
export fn run(context: &Context.Context) -> Outcome.Outcome {
  let project = match Project.load(context.directory) {
    case Ok(found) => found
    case Err(problem) => { return Outcome.failed([problem]) }
  }
  let known = knownTokens()
  var problems = contrastProblems(project.config.preset)

  for path in Project.owned(&project) {
    problems = problems.concat(Audit.audit(path, Result.unwrapOr(Io.read(path), ""), &known))
  }

  if problems.isEmpty() { Outcome.done(["No problems found"]) } else { Outcome.failed(problems) }
}
