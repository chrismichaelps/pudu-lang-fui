/** @Fui.Cli.Icons.Module — fetched icons as owned source */
module PuduLangFui.Cli.Model.Icons

import Std.Json as Json
import Std.List as List
import Std.Map as Map
import Std.Option as Option
import PuduLangFui.Constants.Cli as Constant
import PuduLangFui.Utils.Numbers as Numbers

/** @Fui.Cli.Icons.Glyph — one fetched icon */
export type Glyph = { name: Str, body: Str, width: Int, height: Int }

/// An icon name split into its library and its own name.
export fn split(name: Str) -> Option[(Str, Str)] {
  let pieces = name.split(":")

  if pieces.length() != 2 || pieces[0].isEmpty() || pieces[1].isEmpty() { return None }

  Some((pieces[0], pieces[1]))
}

/// A whole-number field, or the fallback.
fn wholeOr(value: &Json.Json, key: Str, fallback: Int) -> Int {
  Option.unwrapOr(Option.andThen(Json.field(value, key), |held: Json.Json| Json.asInt(&held)), fallback)
}

/// Every glyph an answer holds for one library.
export fn glyphsOf(library: Str, answer: &Json.Json) -> Array[Glyph] {
  let width = wholeOr(answer, "width", Constant.DEFAULT_ICON_SIZE)
  let height = wholeOr(answer, "height", Constant.DEFAULT_ICON_SIZE)
  let icons = Option.unwrapOr(Option.andThen(Json.field(answer, "icons"), |held: Json.Json| Json.asObject(&held)), [])
  var found: Array[Glyph] = []

  for entry in icons {
    let body = Option.unwrapOr(Option.andThen(Json.field(&entry[1], "body"), |held: Json.Json| Json.asText(&held)), "")

    if !body.isEmpty() {
      found = found.push(Glyph{name: library + ":" + entry[0], body: body, width: wholeOr(&entry[1], "width", width), height: wholeOr(&entry[1], "height", height)})
    }
  }

  found
}

/// A drawing as the body of a string literal.
export fn escaped(body: Str) -> Str { body.replace("\\", "\\\\").replace("\"", "\\\"").replace("\{", "\\\{").replace("\}", "\\\}").replace("\n", " ") }

/// A glyph as a line of the owned table.
fn entryOf(glyph: &Glyph) -> Str {
  "    (\"" + glyph.name + "\", (\"0 0 " + show(glyph.width) + " " + show(glyph.height) + "\", \"" + escaped(glyph.body) + "\"))"
}

/// The glyphs with names, newest winning, sorted by name.
export fn merged(existing: &Array[Glyph], added: &Array[Glyph]) -> Array[Glyph] {
  var table: Map[Str, Glyph] = mapOf([])

  for glyph in existing { table = Map.insert(&table, glyph.name, glyph) }

  for glyph in added { table = Map.insert(&table, glyph.name, glyph) }

  Map.values(&table)
}

/// The owned source holding the glyphs.
export fn moduleText(root: Str, glyphs: &Array[Glyph]) -> Str {
  let entries = glyphs.map(|glyph: Glyph| entryOf(&glyph)).join(",\n")

  ["/** @" + root + ".Icons.Module — generated by fui icons add; do not edit */",
    "module " + root + ".Icons",
    "",
    "import Std.Html as Html",
    "import Std.Html.Build as H",
    "import Std.Option as Option",
    "import PuduLangFui.Core.Styling as Core",
    "",
    "/// Each icon's view box and drawing.",
    "const GLYPHS: Map[Str, (Str, Str)] = mapOf([",
    entries,
    "  ])",
    "",
    "/// An icon by its library and name, as in `library:name`; hidden from assistive software.",
    "export fn icon(name: Str) -> H.Node \{",
    "  let (box, drawing) = Option.unwrapOr(GLYPHS.get(name), (\"0 0 24 24\", \"\"))",
    "",
    "  H.Node\{name: \"svg\", attributes: [(\"data-slot\", \"icon\"), (\"viewBox\", box), (\"aria-hidden\", \"true\")], children: [Html.trusted(drawing)]\}.slot(\"icon\")",
    "\}"
  ].join("\n") + "\n"
}

/// The glyphs recorded in an owned source, so fetching more keeps them.
export fn recorded(source: Str) -> Array[Glyph] {
  var found: Array[Glyph] = []

  for line in source.split("\n") {
    if line.startsWith("    (\"") {
      let pieces = line.split("\", (\"")

      if pieces.length() == 2 {
        let name = pieces[0].drop(6)
        let rest = pieces[1].split("\", \"")

        if rest.length() >= 2 {
          let box = List.drop(&rest[0].split(" "), 2)

          found = found.push(Glyph{name: name, body: unescaped(rest[1]), width: Option.unwrapOr(box[0].toInt(), Constant.DEFAULT_ICON_SIZE), height: Option.unwrapOr(box[1].toInt(), Constant.DEFAULT_ICON_SIZE)})
        }
      }
    }
  }

  found
}

/// A table entry's drawing back as plain text.
fn unescaped(text: Str) -> Str {
  let closing = if text.endsWith("\")),") { text.take(text.length() - 4) } else { text.take(text.length() - 3) }

  closing.replace("\\\{", "\{").replace("\\\}", "\}").replace("\\\"", "\"").replace("\\\\", "\\")
}
