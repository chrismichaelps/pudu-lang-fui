/** @Fui.Cli.IconLibrary.Module — a whole library as owned source */
module PuduLangFui.Cli.Model.IconLibrary

import Std.Json as Json
import Std.Option as Option
import PuduLangFui.Cli.Model.Icons as Icons
import PuduLangFui.Constants.Cli as Constant
import PuduLangFui.Utils.Spelling as Spelling

/** @Fui.Cli.IconLibrary.Library — every icon of one library */
export type Library = { name: Str, title: Str, license: Str, glyphs: Array[Icons.Glyph], orphans: Int }

/// A text field of a value, or empty text.
fn textOf(value: &Json.Json, key: Str) -> Str {
  Option.unwrapOr(Option.andThen(Json.field(value, key), |held: Json.Json| Json.asText(&held)), "")
}

/// A whole-number field, or the fallback.
fn wholeOr(value: &Json.Json, key: Str, fallback: Int) -> Int {
  Option.unwrapOr(Option.andThen(Json.field(value, key), |held: Json.Json| Json.asInt(&held)), fallback)
}

/// A truth field, false when absent.
fn flagOf(value: &Json.Json, key: Str) -> Bool {
  Option.unwrapOr(Option.andThen(Json.field(value, key), |held: Json.Json| Json.asBool(&held)), false)
}

/// The drawing with an alias's rotation and flips applied around its center.
export fn transformed(body: Str, width: Int, height: Int, turns: Int, flipsAcross: Bool, flipsDown: Bool) -> Str {
  if turns == 0 && !flipsAcross && !flipsDown { return body }

  let rotation = "rotate(" + show(turns * 90) + " " + show(width / 2) + " " + show(height / 2) + ")"
  let across = if flipsAcross { "translate(" + show(width) + " 0) scale(-1 1) " } else { "" }
  let down = if flipsDown { "translate(0 " + show(height) + ") scale(1 -1) " } else { "" }

  "<g transform=\"" + across + down + rotation + "\">" + body + "</g>"
}

/// Every alias resolved through the icons it names, and how many name nothing.
fn resolved(document: &Json.Json, direct: &Map[Str, Icons.Glyph], library: Str) -> (Array[Icons.Glyph], Int) {
  let aliases = Option.unwrapOr(Option.andThen(Json.field(document, "aliases"), |held: Json.Json| Json.asObject(&held)), [])
  var found: Array[Icons.Glyph] = []
  var orphans = 0

  for entry in aliases {
    match direct.get(library + ":" + textOf(&entry[1], "parent")) {
      case None => { orphans = orphans + 1 }
      case Some(parent) => {
        let body = transformed(parent.body, parent.width, parent.height, wholeOr(&entry[1], "rotate", 0), flagOf(&entry[1], "hFlip"), flagOf(&entry[1], "vFlip"))

        found = found.push(Icons.Glyph{name: library + ":" + entry[0], body: body, width: parent.width, height: parent.height})
      }
    }
  }

  (found, orphans)
}

/// A library read from its full document.
export fn read(library: Str, document: &Json.Json) -> Library {
  let glyphs = Icons.glyphsOf(library, document)
  var direct: Map[Str, Icons.Glyph] = mapOf([])

  for glyph in glyphs { direct = direct.insert(glyph.name, glyph) }

  let (aliases, orphans) = resolved(document, &direct, library)
  let info = Option.unwrapOr(Json.field(document, "info"), Json.Null)
  let license = Option.unwrapOr(Json.field(&info, "license"), Json.Null)

  Library{name: library, title: textOf(&info, "name"), license: textOf(&license, "title"), glyphs: glyphs.concat(aliases), orphans: orphans}
}

/// The module name a library takes.
export fn moduleName(root: Str, library: Str) -> Str { root + "." + Constant.ICONS_MODULE + "." + Spelling.pascal(library) }

/// A glyph as a line of the library's table, without its library prefix.
fn entryOf(library: Str, glyph: &Icons.Glyph) -> Str {
  "    (\"" + glyph.name.drop(library.length() + 1) + "\", (\"0 0 " + show(glyph.width) + " " + show(glyph.height) + "\", \"" + Icons.escaped(glyph.body) + "\"))"
}

/// The owned source of a whole library.
export fn moduleText(root: Str, held: &Library) -> Str {
  let entries = held.glyphs.map(|glyph: Icons.Glyph| entryOf(held.name, &glyph)).join(",\n")

  ["/** @" + root + ".Icons." + Spelling.pascal(held.name) + ".Module — generated by fui icons library; " + held.title + ", license: " + held.license + " */",
    "module " + moduleName(root, held.name),
    "",
    "import Std.Html as Html",
    "import Std.Html.Build as H",
    "import Std.Option as Option",
    "",
    "/// Each icon's view box and drawing.",
    "const GLYPHS: Map[Str, (Str, Str)] = mapOf([",
    entries,
    "  ])",
    "",
    "/// An icon by its name; hidden from assistive software.",
    "export fn icon(name: Str) -> H.Node \{",
    "  let (box, drawing) = Option.unwrapOr(GLYPHS.get(name), (\"0 0 24 24\", \"\"))",
    "",
    "  H.Node\{name: \"svg\", attributes: [(\"data-slot\", \"icon\"), (\"viewBox\", box), (\"aria-hidden\", \"true\")], children: [Html.trusted(drawing)]\}",
    "\}"
  ].join("\n") + "\n"
}
