/** @Fui.Cli.Scaffold.Module — fills the generator's templates */
module PuduLangFui.Cli.Model.Scaffold

import PuduLangFui.Constants.Templates as Templates
import PuduLangFui.Utils.Spelling as Spelling

/// The lines joined with placeholders replaced.
fn filled(lines: &Array[Str], replacements: &Array[(Str, Str)]) -> Str {
  var text = lines.join("\n") + "\n"

  for replacement in replacements { text = text.replace(replacement[0], replacement[1]) }

  text
}

/// The owned theme of a project.
export fn theme(root: Str, preset: Str) -> Str { filled(&Templates.THEME, &[("__ROOT__", root), ("__PRESET__", preset)]) }

/// A kebab name in lower camel case.
export fn camel(name: Str) -> Str {
  let pascal = Spelling.pascal(name)

  pascal.take(1).toLower() + pascal.drop(1)
}

/// A new component for a module path.
export fn component(root: Str, moduleName: Str, name: Str) -> Str {
  filled(&Templates.COMPONENT, &[("__ROOT__", root), ("__MODULE__", moduleName), ("__PASCAL__", Spelling.pascal(name)), ("__CAMEL__", camel(name)), ("__NAME__", name)])
}

/// A catalog listing the style block of each `(module, alias)` pair.
export fn catalog(root: Str, modules: &Array[(Str, Str)]) -> Str {
  var lines = ["/** @" + root + ".Catalog.Module — generated by fui; do not edit */", "module " + root + ".Catalog", ""]

  for entry in modules { lines = lines.push("import " + entry[0] + " as " + entry[1]) }

  lines = lines.push("import PuduLangFui.Domain.Css as Css").push("").push("/// Every owned component's styles.").push("export fn blocks() -> Array[Css.Block] \{").push("  [")

  var index = 0

  for entry in modules {
    index = index + 1
    lines = lines.push("    " + entry[1] + ".style()" + (if index < modules.length() { "," } else { "" }))
  }

  lines.push("  ]").push("\}").join("\n") + "\n"
}
