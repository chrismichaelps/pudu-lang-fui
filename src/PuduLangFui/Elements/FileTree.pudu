/** @Fui.Elements.FileTree.Element — changed files as a tree */
module PuduLangFui.Elements.FileTree

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
/** @Fui.Elements.FileTree.Change — what happened to a file */
export type Change = Unchanged | Added | Modified | Deleted

/** @Fui.Elements.FileTree.Entry — a file or a folder of entries */
export type Entry = FileEntry(Str, Change) | FolderEntry(Str, Array[Entry])

/// The mark each change shows.
const MARKS: Map[Str, Str] = mapOf([("unchanged", ""), ("added", "A"), ("modified", "M"), ("deleted", "D")])

/// A file.
export fn file(name: Str, change: Change) -> Entry { FileEntry(name, change) }

/// A folder of entries.
export fn folder(name: Str, entries: Array[Entry]) -> Entry { FolderEntry(name, entries) }

/// One entry written out, folders holding their contents.
fn written(entry: &Entry) -> H.Node {
  match entry {
    case FileEntry(name, change) => H.li().slot("file-tree-file").data("change", Core.spelled(change)).holding([
        Icon.sized(Icon.File, Icon.Small),
        H.span().says(name),
        Core.inline("file-tree-mark").says(Core.picked(&MARKS, change, ""))
      ])
    case FolderEntry(name, entries) => H.li().holding([
        H.details().slot("file-tree-folder").flag("open").holding([
            H.summary().slot("file-tree-name").holding([Core.inline("file-tree-chevron").holding([Icon.sized(Icon.ChevronRight, Icon.Small)]), Icon.sized(Icon.Folder, Icon.Small), H.span().says(name)]),
            H.ul().slot("file-tree-list").holding(entries.map(|inner: Entry| written(&inner)))
          ])
      ])
  }
}

/// A tree of the given entries.
export fn fileTree(entries: Array[Entry]) -> H.Node {
  H.ul().slot("file-tree").holding(entries.map(|inner: Entry| written(&inner)))
}

/// The styles of a file tree.
export fn style() -> Css.Block {
  Css.block("file-tree", [
      Css.base("list-style: none; font-size: $text-sm"),
      Css.slot("file-tree-list", "padding-inline-start: $space-4; list-style: none"),
      Css.slot("file-tree-file", "display: flex; align-items: center; gap: calc($unit * 1.5); padding: $unit $space-2; padding-inline-start: 1.625rem; border-radius: $radius-md; cursor: default"),
      Css.slotWhen("file-tree-file", ":hover", "background: $muted"),
      Css.slot("file-tree-folder", "display: block"),
      Css.slot("file-tree-name", "display: flex; align-items: center; gap: calc($unit * 1.5); padding: $unit $space-2; border-radius: $radius-md; cursor: pointer; list-style: none"),
      Css.slotWhen("file-tree-name", ":hover", "background: $muted"),
      Css.slotWhen("file-tree-name", "::-webkit-details-marker", "display: none"),
      Css.slot("file-tree-chevron", "display: inline-flex; color: $muted-foreground; transition: rotate $duration-base $ease-standard"),
      Css.rule("[data-slot=\"file-tree-folder\"][open] > [data-slot=\"file-tree-name\"] > [data-slot=\"file-tree-chevron\"]", "rotate: 90deg"),
      Css.slot("file-tree-mark", "margin-inline-start: auto; font-family: $font-mono; font-size: $text-xs; font-weight: $weight-semibold"),
      Css.rule("[data-slot=\"file-tree-file\"][data-change=\"added\"] > [data-slot=\"file-tree-mark\"]", "color: $success"),
      Css.rule("[data-slot=\"file-tree-file\"][data-change=\"deleted\"] > [data-slot=\"file-tree-mark\"]", "color: $destructive"),
      Css.rule("[data-slot=\"file-tree-file\"][data-change=\"modified\"] > [data-slot=\"file-tree-mark\"]", "color: $warning")
    ])
}
