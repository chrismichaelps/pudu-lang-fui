/** @Fui.Elements.FileTree.Element — changed files as a tree */
module PuduLangFui.Elements.FileTree

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/** @Fui.Elements.FileTree.Change — what happened to a file */
export type Change = Unchanged | Added | Modified | Deleted

/** @Fui.Elements.FileTree.Entry — a file or a folder of entries */
export type Entry = FileEntry(Str, Change) | FolderEntry(Str, Array[Entry])

/// The mark each change shows.
const MARKS: Map[Str, Str] = mapOf([("unchanged", ""), ("added", "A"), ("modified", "M"), ("deleted", "D")])

/// A file.
export fn file(name: Str, change: Change) -> Entry { FileEntry(name, change) }

/// A folder of entries.
export fn folder(name: Str, entries: Array[Entry]) -> Entry { FolderEntry(name, entries) }

/// One entry written out, folders holding their contents.
fn written(entry: &Entry) -> H.Node {
  match entry {
    case FileEntry(name, change) => H.li().slot("file-tree-file").data("change", Core.spelled(change)).holding([
        Icon.sized(Icon.File, Icon.Small),
        H.words(name),
        Core.inline("file-tree-mark").says(Core.picked(&MARKS, change, ""))
      ])
    case FolderEntry(name, entries) => H.li().holding([
        H.details().slot("file-tree-folder").flag("open").holding([
            H.summary().slot("file-tree-name").holding([Icon.sized(Icon.Folder, Icon.Small), H.words(name)]),
            H.ul().slot("file-tree-list").holding(entries.map(|inner: Entry| written(&inner)))
          ])
      ])
  }
}

/// A tree of the given entries.
export fn fileTree(entries: Array[Entry]) -> H.Node {
  H.ul().slot("file-tree").holding(entries.map(|inner: Entry| written(&inner)))
}

/// The styles of a file tree.
export fn style() -> Css.Block {
  Css.block("file-tree", [
      Css.base("margin: 0; padding: 0; list-style: none; font-family: $font-mono; font-size: $text-xs"),
      Css.slot("file-tree-list", "margin: 0; padding-inline-start: $space-4; list-style: none"),
      Css.slot("file-tree-file", "display: flex; align-items: center; gap: $space-1; padding-block: 2px"),
      Css.slot("file-tree-folder", "display: block"),
      Css.slot("file-tree-name", "display: flex; align-items: center; gap: $space-1; padding-block: 2px; cursor: pointer; list-style: none"),
      Css.slot("file-tree-mark", "margin-inline-start: auto; font-weight: $weight-semibold"),
      Css.slotWhen("file-tree-file", "[data-change=\"added\"]", "color: $success"),
      Css.slotWhen("file-tree-file", "[data-change=\"deleted\"]", "color: $destructive"),
      Css.slotWhen("file-tree-file", "[data-change=\"modified\"]", "color: $warning")
    ])
}
