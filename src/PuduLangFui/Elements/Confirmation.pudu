/** @Fui.Elements.Confirmation.Element — approval before a tool runs */
module PuduLangFui.Elements.Confirmation

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Button as Button
import PuduLangFui.Components.Primitives.Card as Card
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// A request posted to `action` with a `decision` of `approve` or `deny`.
export fn confirmation(title: Str, detail: Str, action: Str) -> H.Node {
  H.form().slot("confirmation").method("post").action(action).holding([
      Card.sized(Card.Compact).holding([
          Card.header().holding([Card.title().says(title), Card.description().says(detail)]),
          Card.footer().css("justify-content", "flex-end").css("gap", "var(--fui-space-2)").holding([
              Button.submit(Button.props().variant(Button.Outline).size(Button.Small)).name("decision").value("deny").says("Deny"),
              Button.submit(Button.props().size(Button.Small)).name("decision").value("approve").says("Approve")
            ])
        ])
    ])
}

/// The styles of a confirmation.
export fn style() -> Css.Block { Css.block("confirmation", [Css.base("display: block; margin: 0")]) }
