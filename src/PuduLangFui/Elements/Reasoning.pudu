/** @Fui.Elements.Reasoning.Element — thinking as it streams */
module PuduLangFui.Elements.Reasoning

import Std.Html.Build as H
import PuduLangFui.Components.Composites.Trace as Trace
import PuduLangFui.Components.Primitives.Effects as Effects
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
/** @Fui.Elements.Reasoning.State — whether thinking is under way */
export type State = Thinking | Finished

/// The caption each state reads.
const CAPTIONS: Map[Str, Str] = mapOf([("thinking", "Thinking"), ("finished", "Thought")])

/// The headline each state shows.
const HEADLINES: Map[Str, fn(Str) -> H.Node] = mapOf([("thinking", shimmering), ("finished", plain)])

/// A caption with a moving highlight.
fn shimmering(caption: Str) -> H.Node { Effects.shimmer().says(caption) }

/// A plain caption.
fn plain(caption: Str) -> H.Node { H.words(caption) }

/// The thinking under a caption; `duration` follows it when given, and it starts open while under way or when `open` holds.
export fn reasoning(state: State, thought: H.Node, duration: Str = "", open: Bool = false) -> H.Node {
  let caption = Core.picked(&CAPTIONS, state, "Thought")
  let headline = Core.picked(&HEADLINES, state, plain)

  Core.part("reasoning").holding([
      Trace.disclosure([headline(caption), H.span().says(duration)], open || state == Thinking).holding([Core.part("reasoning-content").holding([thought])])
    ])
}

/// The styles of reasoning.
export fn style() -> Css.Block {
  Css.block("reasoning", [
      Css.base("display: block"),
      Css.slot("reasoning-content", "color: $muted-foreground; font-size: $text-sm")
    ])
}
