/** @Fui.Elements.TestResults.Element — a test run */
module PuduLangFui.Elements.TestResults

import Std.Html.Build as H
import Std.Option as Option
import PuduLangFui.Components.Composites.Trace as Trace
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
/** @Fui.Elements.TestResults.Outcome — how a suite ended */
export type Outcome = Passed | Failed | Skipped

/** @Fui.Elements.TestResults.Suite — one suite's result */
export type Suite = { name: Str, outcome: Outcome, failures: Array[Str] }

/// The step status each outcome reads as.
const STATUSES: Map[Str, Trace.Status] = mapOf([("passed", Trace.Done), ("failed", Trace.Failed), ("skipped", Trace.Pending)])

/// A suite's result.
export fn suite(name: Str, outcome: Outcome, failures: Array[Str] = []) -> Suite {
  Suite{name: name, outcome: outcome, failures: failures}
}

/// One suite written out.
fn written(one: &Suite) -> H.Node {
  Trace.line(Option.unwrapOr(STATUSES.get(Core.spelled(one.outcome)), Trace.Pending)).holding([
      Trace.body().holding([
          Trace.title().says(one.name),
          if one.failures.isEmpty() { H.nothing() } else { H.pre().slot("test-results-failures").says(one.failures.join("\n")) }
        ])
    ])
}

/// A count of what ran, opening to a row per suite.
export fn testResults(suites: Array[Suite]) -> H.Node {
  let failed = suites.filter(|one: Suite| one.outcome == Failed).length()
  let glyph = if failed > 0 { Icon.ErrorCircle } else { Icon.Success }

  Core.part("test-results").data("failed", show(failed)).holding([
      Trace.disclosure([Icon.sized(glyph, Icon.Small), H.words("Ran " + show(suites.length()) + " suites, " + show(failed) + " failed")], true).holding([Trace.trace().holding(suites.map(|one: Suite| written(&one)))])
    ])
}

/// The styles of test results.
export fn style() -> Css.Block {
  Css.block("test-results", [
      Css.base("display: block"),
      Css.rule("[data-slot=\"test-results\"]:not([data-failed=\"0\"]) > [data-slot=\"trace-details\"] > [data-slot=\"trace-summary\"]", "color: $destructive"),
      Css.slot("test-results-failures", "margin: $unit 0 0; padding: $space-3; background: color-mix(in oklab, $muted 60%, transparent); color: $foreground; border-radius: $radius-lg; font-family: $font-mono; font-size: $text-xs; white-space: pre-wrap")
    ])
}
