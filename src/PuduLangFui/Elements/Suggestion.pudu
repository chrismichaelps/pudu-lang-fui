/** @Fui.Elements.Suggestion.Element — a one-click prompt */
module PuduLangFui.Elements.Suggestion

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.Button as Button
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// Suggestions in a row, posted as `prompt` to `action`.
export fn suggestions(action: Str, prompts: &Array[Str]) -> H.Node {
  H.form().slot("suggestions").method("post").action(action).holding(prompts.map(|prompt: Str| Button.submit(Button.props().variant(Button.Outline).size(Button.Small)).css("border-radius", "9999px").name("prompt").value(prompt).says(prompt)))
}

/// The styles of suggestions.
export fn style() -> Css.Block { Css.block("suggestions", [Css.base("display: flex; flex-wrap: wrap; gap: $space-2; margin: 0")]) }
