/** @Fui.Elements.StackTrace.Element — a failure and its frames */
module PuduLangFui.Elements.StackTrace

import Std.Html.Build as H
import PuduLangFui.Components.Composites.Trace as Trace
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
/// One frame of the stack.
fn written(frame: Str) -> H.Node { H.li().slot("stack-trace-frame").holding([Icon.sized(Icon.File, Icon.Small), H.span().says(frame)]) }

/// The failure's message, opening to its frames.
export fn stackTrace(message: Str, frames: &Array[Str]) -> H.Node {
  Core.part("stack-trace").holding([
      Trace.disclosure([Icon.sized(Icon.ErrorCircle, Icon.Small), H.words(message)], !frames.isEmpty()).holding([H.ol().slot("stack-trace-frames").holding(frames.map(written))])
    ])
}

/// The styles of a stack trace.
export fn style() -> Css.Block {
  Css.block("stack-trace", [
      Css.base("display: block"),
      Css.rule("[data-slot=\"stack-trace\"] [data-slot=\"trace-summary\"]", "color: $destructive"),
      Css.slot("stack-trace-frames", "display: flex; flex-direction: column; gap: $unit; list-style: none"),
      Css.slot("stack-trace-frame", "display: flex; align-items: center; gap: calc($unit * 1.5); color: $muted-foreground; font-family: $font-mono; font-size: $text-xs")
    ])
}
