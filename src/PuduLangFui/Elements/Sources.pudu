/** @Fui.Elements.Sources.Element — links a reply used */
module PuduLangFui.Elements.Sources

import Std.Html.Build as H
import PuduLangFui.Components.Composites.Trace as Trace
import PuduLangFui.Components.Primitives.Icon as Icon
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css
/** @Fui.Elements.Sources.Source — one link used */
export type Source = { title: Str, target: Str }

/// A link used.
export fn source(title: Str, target: Str) -> Source { Source{title: title, target: target} }

/// One link written out.
fn written(one: &Source) -> H.Node {
  H.li().holding([H.a().slot("sources-link").href(one.target).at("rel", "noopener noreferrer").holding([H.words(one.title), Icon.sized(Icon.ArrowUpRight, Icon.Small)])])
}

/// The links under a count, or nothing when there are none.
export fn sources(all: Array[Source], open: Bool = false) -> H.Node {
  if all.isEmpty() { return H.nothing() }

  Core.part("sources").holding([
      Trace.disclosure([Icon.sized(Icon.Globe, Icon.Small), H.words("Used " + show(all.length()) + " sources")], open).holding([H.ul().slot("sources-list").holding(all.map(|one: Source| written(&one)))])
    ])
}

/// The styles of sources.
export fn style() -> Css.Block {
  Css.block("sources", [
      Css.base("display: block"),
      Css.slot("sources-list", "display: flex; flex-direction: column; gap: $space-1; list-style: none"),
      Css.slot("sources-link", "display: inline-flex; align-items: center; gap: $unit; color: $muted-foreground; font-size: $text-sm; text-decoration: none"),
      Css.slotWhen("sources-link", ":hover", "color: $foreground")
    ])
}
