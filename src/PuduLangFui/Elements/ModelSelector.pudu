/** @Fui.Elements.ModelSelector.Element — picks a model and an effort */
module PuduLangFui.Elements.ModelSelector

import Std.Html.Build as H
import PuduLangFui.Components.Primitives.NativeSelect as NativeSelect
import PuduLangFui.Core.Styling as Core
import PuduLangFui.Domain.Css as Css

/// Options with the current value selected.
fn choices(values: &Array[Str], current: Str) -> Array[H.Node] {
  values.map(|value: Str| NativeSelect.option(value, value, value == current))
}

/// Two selects for the model and how hard it works.
export fn modelSelector(models: &Array[Str], efforts: &Array[Str], model: Str, effort: Str) -> H.Node {
  Core.part("model-selector").holding([
      NativeSelect.select("model").label("Model").holding(choices(models, model)),
      NativeSelect.select("effort").label("Effort").holding(choices(efforts, effort))
    ])
}

/// The styles of a selector.
export fn style() -> Css.Block { Css.block("model-selector", [Css.base("display: inline-flex; gap: $space-2")]) }
