/** @Fui.Constants.DrawerScript.Module — what a drawer does in a page */
module PuduLangFui.Constants.DrawerScript

/// The script, one line per entry.
export const LINES: Array[Str] = [
  "(function () \{",
  "  var DURATION = 500, EASE = 'cubic-bezier(0.32, 0.72, 0, 1)', VELOCITY = 0.4, CLOSE_THRESHOLD = 0.25, SCROLL_LOCK = 100, RADIUS = 8, WINDOW_OFFSET = 26, NESTED = 16, DOUBLE_TAP = 120, LONG_PRESS = 250;",
  "  var states = new WeakMap(), press = null, lastScroll = 0;",
  "  function panelOf(drawer) \{ return drawer.querySelector(':scope > [data-slot=drawer-panel]'); \}",
  "  function overlayOf(drawer) \{ return drawer.querySelector(':scope > [data-slot=drawer-overlay]'); \}",
  "  function wrapper() \{ return document.querySelector('[data-slot=drawer-wrapper]'); \}",
  "  function isVertical(drawer) \{ var d = drawer.dataset.direction; return d === 'bottom' || d === 'top'; \}",
  "  function outward(drawer) \{",
  "    var d = drawer.dataset.direction;",
  "    if (d === 'bottom') return 1;",
  "    if (d === 'top') return -1;",
  "    return (d === 'end') !== (getComputedStyle(drawer).direction === 'rtl') ? 1 : -1;",
  "  \}",
  "  function viewport(drawer) \{ return isVertical(drawer) ? innerHeight : innerWidth; \}",
  "  function extent(drawer) \{ var box = panelOf(drawer).getBoundingClientRect(); return isVertical(drawer) ? box.height : box.width; \}",
  "  function points(drawer) \{",
  "    var raw = drawer.dataset.snapPoints;",
  "    if (!raw) return [];",
  "    var size = extent(drawer), view = viewport(drawer);",
  "    return raw.split(',').map(function (point) \{",
  "      var visible = point.slice(-2) === 'px' ? parseInt(point, 10) : parseFloat(point) * view;",
  "      return Math.max(0, size - visible);",
  "    \});",
  "  \}",
  "  function stateOf(drawer) \{",
  "    var state = states.get(drawer);",
  "    if (!state) \{ state = \{ offset: 0, index: 0, opened: 0 \}; states.set(drawer, state); \}",
  "    return state;",
  "  \}",
  "  function emit(drawer, name, detail) \{ drawer.dispatchEvent(new CustomEvent('fui-drawer-' + name, \{ bubbles: true, detail: detail \})); \}",
  "  function transition(node, property, on) \{ node.style.transition = on ? property + ' ' + DURATION + 'ms ' + EASE : 'none'; \}",
  "  function place(drawer, offset, animated) \{",
  "    var panel = panelOf(drawer), amount = offset * outward(drawer);",
  "    transition(panel, 'translate', animated);",
  "    panel.style.translate = isVertical(drawer) ? '0 ' + amount + 'px' : amount + 'px 0';",
  "    stateOf(drawer).offset = offset;",
  "  \}",
  "  function fade(drawer, offset, animated) \{",
  "    var overlay = overlayOf(drawer), snaps = points(drawer), value = 1;",
  "    if (!overlay) return;",
  "    if (snaps.length) \{",
  "      var from = fadeIndex(drawer, snaps), start = snaps[from], end = snaps[Math.max(from - 1, 0)];",
  "      value = offset <= start ? 1 : from === 0 ? Math.max(0, 1 - (offset - start) / Math.max(extent(drawer) - start, 1)) : Math.max(0, 1 - (offset - start) / Math.max(end - start, 1));",
  "    \} else value = Math.max(0, 1 - offset / Math.max(extent(drawer), 1));",
  "    transition(overlay, 'opacity', animated);",
  "    overlay.style.opacity = String(value);",
  "  \}",
  "  function fadeIndex(drawer, snaps) \{ var given = parseInt(drawer.dataset.fadeFrom, 10); return isNaN(given) ? snaps.length - 1 : Math.min(given, snaps.length - 1); \}",
  "  function scale(progress, animated, drawer) \{",
  "    var host = wrapper();",
  "    if (!host || drawer.dataset.scales !== 'true') return;",
  "    var low = (innerWidth - WINDOW_OFFSET) / innerWidth, vertical = isVertical(drawer), shift = 'calc(env(safe-area-inset-top) + 14px)';",
  "    host.style.transformOrigin = vertical ? 'top' : 'left';",
  "    host.style.transition = animated ? 'scale ' + DURATION + 'ms ' + EASE + ', translate ' + DURATION + 'ms ' + EASE + ', border-radius ' + DURATION + 'ms ' + EASE : 'none';",
  "    host.style.overflow = 'hidden';",
  "    if (progress <= 0) \{ host.style.scale = ''; host.style.translate = ''; host.style.borderRadius = ''; return; \}",
  "    host.style.scale = String(1 - (1 - low) * progress);",
  "    host.style.translate = vertical ? '0 calc(' + shift + ' * ' + progress + ')' : 'calc(' + shift + ' * ' + progress + ') 0';",
  "    host.style.borderRadius = (RADIUS * progress) + 'px';",
  "    if (drawer.dataset.scaleBody !== 'false') document.body.style.background = 'black';",
  "  \}",
  "  function parentDrawer(drawer) \{ return drawer.parentElement && drawer.parentElement.closest('[data-slot=drawer]'); \}",
  "  function nest(drawer, progress, animated) \{",
  "    var parent = parentDrawer(drawer);",
  "    if (!parent || drawer.dataset.nested !== 'true') return;",
  "    var panel = panelOf(parent), view = viewport(parent), low = (view - NESTED) / view, out = outward(parent) * -1;",
  "    panel.style.transition = animated ? 'scale ' + DURATION + 'ms ' + EASE + ', translate ' + DURATION + 'ms ' + EASE : 'none';",
  "    panel.style.scale = progress > 0 ? String(1 - (1 - low) * progress) : '';",
  "    var base = stateOf(parent).offset * outward(parent) + out * NESTED * progress;",
  "    panel.style.translate = isVertical(parent) ? '0 ' + base + 'px' : base + 'px 0';",
  "  \}",
  "  function snapTo(drawer, index) \{",
  "    var snaps = points(drawer), state = stateOf(drawer), bounded = Math.max(0, Math.min(index, snaps.length - 1));",
  "    state.index = bounded;",
  "    place(drawer, snaps[bounded], true);",
  "    fade(drawer, snaps[bounded], true);",
  "    drawer.dataset.activeSnap = String(bounded);",
  "    emit(drawer, 'snap', \{ index: bounded \});",
  "  \}",
  "  function opened(drawer) \{",
  "    var snaps = points(drawer), state = stateOf(drawer), hidden = extent(drawer);",
  "    state.opened = Date.now();",
  "    state.index = Math.min(parseInt(drawer.dataset.activeSnap || '0', 10) || 0, Math.max(snaps.length - 1, 0));",
  "    place(drawer, hidden, false);",
  "    fade(drawer, hidden, false);",
  "    drawer.getBoundingClientRect();",
  "    var rest = snaps.length ? snaps[state.index] : 0;",
  "    place(drawer, rest, true);",
  "    fade(drawer, rest, true);",
  "    scale(1, true, drawer);",
  "    nest(drawer, 1, true);",
  "    emit(drawer, 'open-change', \{ open: true \});",
  "    setTimeout(function () \{ emit(drawer, 'animation-end', \{ open: true \}); \}, DURATION);",
  "  \}",
  "  function closing(drawer) \{",
  "    var hidden = extent(drawer);",
  "    if (drawer.dataset.closing) return;",
  "    drawer.dataset.closing = 'true';",
  "    place(drawer, hidden, true);",
  "    fade(drawer, hidden, true);",
  "    scale(0, true, drawer);",
  "    nest(drawer, 0, true);",
  "    setTimeout(function () \{",
  "      delete drawer.dataset.closing;",
  "      if (drawer.open) drawer.close();",
  "      var panel = panelOf(drawer);",
  "      panel.style.translate = '';",
  "      panel.style.transition = '';",
  "      if (drawer.dataset.scaleBody !== 'false') document.body.style.removeProperty('background');",
  "      emit(drawer, 'close', \{\});",
  "      emit(drawer, 'open-change', \{ open: false \});",
  "      emit(drawer, 'animation-end', \{ open: false \});",
  "    \}, DURATION);",
  "  \}",
  "  function dampen(value) \{ return 8 * (Math.log(value + 1) - 2); \}",
  "  function scrolled(target, panel, closingDirection) \{",
  "    var node = target;",
  "    while (node && node !== panel) \{",
  "      if (node.scrollHeight > node.clientHeight && getComputedStyle(node).overflowY !== 'hidden') \{",
  "        if (node.scrollTop !== 0 && closingDirection) return true;",
  "        if (node.getAttribute('role') === 'dialog') return false;",
  "      \}",
  "      node = node.parentElement;",
  "    \}",
  "    return false;",
  "  \}",
  "  document.addEventListener('scroll', function () \{ lastScroll = Date.now(); \}, true);",
  "  document.addEventListener('pointerdown', function (event) \{",
  "    var panel = event.target.closest && event.target.closest('[data-slot=drawer-panel]');",
  "    if (!panel || event.button === 2) return;",
  "    var drawer = panel.parentElement, handle = event.target.closest('[data-slot=drawer-handle]');",
  "    if (drawer.dataset.handleOnly === 'true' && !handle) return;",
  "    if (event.target.closest('[data-no-drag],button,a,input,textarea,select,label')) return;",
  "    if (drawer.dataset.dismissible === 'false' && !drawer.dataset.snapPoints) return;",
  "    press = \{ drawer: drawer, panel: panel, handle: handle, target: event.target, id: event.pointerId, x: event.clientX, y: event.clientY, time: Date.now(), start: stateOf(drawer).offset, active: false, ignored: false, long: false \};",
  "    if (handle) setTimeout(function () \{ if (press) press.long = true; \}, LONG_PRESS);",
  "  \});",
  "  document.addEventListener('pointermove', function (event) \{",
  "    if (!press || press.ignored) return;",
  "    var drawer = press.drawer, vertical = isVertical(drawer), along = (vertical ? event.clientY - press.y : event.clientX - press.x) * outward(drawer), across = vertical ? event.clientX - press.x : event.clientY - press.y;",
  "    if (!press.active) \{",
  "      if (Math.abs(along) < 3 && Math.abs(across) < 3) return;",
  "      if (Math.abs(across) > Math.abs(along) || scrolled(press.target, press.panel, along > 0) || Date.now() - lastScroll < parseInt(drawer.dataset.scrollLock || SCROLL_LOCK, 10) || (window.getSelection() && window.getSelection().toString().length > 0)) \{ press.ignored = true; return; \}",
  "      press.active = true;",
  "      press.panel.setPointerCapture(press.id);",
  "      drawer.dataset.dragging = 'true';",
  "    \}",
  "    var snaps = points(drawer), floor = snaps.length ? Math.min.apply(null, snaps) : 0, value = press.start + along;",
  "    if (value < floor) value = snaps.length ? floor - Math.max(0, dampen(floor - value)) : -Math.max(0, dampen(-value));",
  "    if (drawer.dataset.dismissible === 'false' && snaps.length && value > Math.max.apply(null, snaps)) value = Math.max.apply(null, snaps) + Math.max(0, dampen(value - Math.max.apply(null, snaps)));",
  "    if (drawer.dataset.dismissible === 'false' && !snaps.length && value > 0) value = Math.max(0, dampen(value));",
  "    place(drawer, value, false);",
  "    fade(drawer, value, false);",
  "    var progress = 1 - Math.min(Math.max(value / Math.max(extent(drawer), 1), 0), 1);",
  "    scale(progress, false, drawer);",
  "    nest(drawer, progress, false);",
  "    emit(drawer, 'drag', \{ percentage: 1 - progress \});",
  "  \});",
  "  function cycle(drawer) \{",
  "    var snaps = points(drawer), state = stateOf(drawer), dismissible = drawer.dataset.dismissible !== 'false';",
  "    if (!snaps.length) \{ if (!dismissible) closing(drawer); return; \}",
  "    if (state.index === snaps.length - 1 && dismissible) \{ closing(drawer); return; \}",
  "    snapTo(drawer, state.index + 1);",
  "  \}",
  "  document.addEventListener('pointerup', function () \{",
  "    if (!press) return;",
  "    var current = press;",
  "    press = null;",
  "    var drawer = current.drawer;",
  "    delete drawer.dataset.dragging;",
  "    if (!current.active) \{",
  "      if (current.handle && !current.long && !current.handle.hasAttribute('data-prevent-cycle')) setTimeout(function () \{ cycle(drawer); \}, DOUBLE_TAP);",
  "      return;",
  "    \}",
  "    var state = stateOf(drawer), snaps = points(drawer), dragged = state.offset - current.start, velocity = Math.abs(dragged) / Math.max(Date.now() - current.time, 1), dismissible = drawer.dataset.dismissible !== 'false', size = extent(drawer), threshold = parseFloat(drawer.dataset.closeThreshold || CLOSE_THRESHOLD);",
  "    emit(drawer, 'release', \{ open: dragged <= 0 \});",
  "    if (!snaps.length) \{",
  "      if (dismissible && dragged > 0 && (velocity > VELOCITY || dragged >= size * threshold)) \{ closing(drawer); return; \}",
  "      place(drawer, 0, true);",
  "      fade(drawer, 0, true);",
  "      scale(1, true, drawer);",
  "      nest(drawer, 1, true);",
  "      return;",
  "    \}",
  "    scale(1, true, drawer);",
  "    var sequential = drawer.dataset.sequential === 'true', last = snaps.length - 1;",
  "    if (!sequential && velocity > 2 && dragged > 0) \{ if (dismissible) closing(drawer); else snapTo(drawer, 0); return; \}",
  "    if (!sequential && velocity > 2 && dragged < 0) \{ snapTo(drawer, last); return; \}",
  "    if (velocity > VELOCITY && Math.abs(dragged) < viewport(drawer) * 0.4) \{",
  "      if (dragged < 0 && state.index === last) \{ snapTo(drawer, last); return; \}",
  "      if (dragged > 0 && state.index === 0) \{ if (dismissible) closing(drawer); else snapTo(drawer, 0); return; \}",
  "      snapTo(drawer, state.index + (dragged < 0 ? 1 : -1));",
  "      return;",
  "    \}",
  "    if (dismissible && state.index === 0 && state.offset > snaps[0] + (size - snaps[0]) * threshold) \{ closing(drawer); return; \}",
  "    var nearest = 0;",
  "    snaps.forEach(function (offset, index) \{ if (Math.abs(offset - state.offset) < Math.abs(snaps[nearest] - state.offset)) nearest = index; \});",
  "    snapTo(drawer, nearest);",
  "  \});",
  "  document.addEventListener('click', function (event) \{",
  "    var control = event.target.closest && event.target.closest('[command=close],[command=\"--fui-show\"]');",
  "    if (!control) return;",
  "    var drawer = document.getElementById(control.getAttribute('commandfor'));",
  "    if (!drawer || !drawer.matches('[data-slot=drawer]')) return;",
  "    event.preventDefault();",
  "    if (control.getAttribute('command') === 'close') closing(drawer); else drawer.show();",
  "  \}, true);",
  "  document.addEventListener('cancel', function (event) \{",
  "    if (!event.target.matches('[data-slot=drawer]')) return;",
  "    event.preventDefault();",
  "    if (event.target.dataset.dismissible !== 'false') closing(event.target);",
  "  \}, true);",
  "  function watch(drawer) \{",
  "    new MutationObserver(function () \{ if (drawer.open && !drawer.dataset.closing) opened(drawer); \}).observe(drawer, \{ attributes: true, attributeFilter: ['open'] \});",
  "    if (drawer.dataset.defaultOpen === 'true') drawer.dataset.modal === 'false' ? drawer.show() : drawer.showModal();",
  "  \}",
  "  if (window.visualViewport) visualViewport.addEventListener('resize', function () \{",
  "    document.querySelectorAll('[data-slot=drawer][open]').forEach(function (drawer) \{ if (drawer.dataset.reposition !== 'false') drawer.style.blockSize = visualViewport.height + 'px'; \});",
  "  \});",
  "  window.fuiDrawer = \{ snapTo: function (id, index) \{ snapTo(document.getElementById(id), index); \}, close: function (id) \{ closing(document.getElementById(id)); \} \};",
  "  function start() \{ document.querySelectorAll('[data-slot=drawer]').forEach(watch); \}",
  "  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();",
  "\})();"
]
