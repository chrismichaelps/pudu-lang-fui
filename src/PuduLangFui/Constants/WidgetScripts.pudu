/** @Fui.Constants.WidgetScripts.Module — the optional behavior of interactive parts */
module PuduLangFui.Constants.WidgetScripts

/// Keeps a slider's fill on its thumb while it moves.
export const SLIDER: Str = "(function () \{\n  if (window.fuiSlider) return;\n  window.fuiSlider = true;\n  function fill(input) \{\n    var low = input.min === '' ? 0 : +input.min, high = input.max === '' ? 100 : +input.max, span = high - low || 1;\n    input.style.setProperty('--slider-fill', ((input.value - low) * 100 / span) + '%');\n  \}\n  document.addEventListener('input', function (event) \{ if (event.target.matches('[data-slot=slider]')) fill(event.target); \});\n  document.addEventListener('reset', function (event) \{ setTimeout(function () \{ event.target.querySelectorAll('[data-slot=slider]').forEach(fill); \}, 0); \});\n\})();"

/// Moves a carousel by one view and disables an arrow at either end.
export const CAROUSEL: Str = "(function () \{\n  if (window.fuiCarousel) return;\n  window.fuiCarousel = true;\n  function view(root) \{ return root.querySelector('[data-slot=carousel-content]'); \}\n  function sync(root) \{\n    var content = view(root), left = Math.abs(content.scrollLeft), end = content.scrollWidth - content.clientWidth;\n    root.querySelector('[data-part=carousel-previous]').disabled = left <= 1;\n    root.querySelector('[data-part=carousel-next]').disabled = left >= end - 1;\n  \}\n  document.addEventListener('click', function (event) \{\n    var button = event.target.closest('[data-part=carousel-previous],[data-part=carousel-next]');\n    if (!button) return;\n    var root = button.closest('[data-slot=carousel]'), content = view(root), step = button.matches('[data-part=carousel-next]') ? 1 : -1;\n    if (getComputedStyle(content).direction === 'rtl') step = -step;\n    content.scrollBy(\{ left: step * content.clientWidth, behavior: 'smooth' \});\n  \});\n  document.querySelectorAll('[data-slot=carousel]').forEach(function (root) \{\n    view(root).addEventListener('scroll', function () \{ sync(root); \}, \{ passive: true \});\n    new ResizeObserver(function () \{ sync(root); \}).observe(view(root));\n    sync(root);\n  \});\n\})();"

/// Opens, filters, and picks from a combobox's list.
export const COMBOBOX: Str = "(function () \{\n  if (window.fuiCombobox) return;\n  window.fuiCombobox = true;\n  function parts(root) \{ return \{ input: root.querySelector('input'), list: root.querySelector('[data-slot=combobox-content]'), empty: root.querySelector('[data-slot=combobox-empty]'), items: Array.prototype.slice.call(root.querySelectorAll('[data-slot=combobox-item]')) \}; \}\n  function isOpen(found) \{ return found.list.matches(':popover-open'); \}\n  function place(root, found) \{\n    var box = root.getBoundingClientRect(), below = innerHeight - box.bottom - 8;\n    found.list.style.left = box.left + 'px';\n    found.list.style.top = (box.bottom + 4) + 'px';\n    found.list.style.setProperty('--anchor-width', box.width + 'px');\n    found.list.style.setProperty('--available-height', below + 'px');\n  \}\n  function open(root, found) \{ if (isOpen(found)) return; found.list.showPopover(); place(root, found); found.input.setAttribute('aria-expanded', 'true'); \}\n  function close(found) \{ if (isOpen(found)) found.list.hidePopover(); found.input.setAttribute('aria-expanded', 'false'); \}\n  function filter(found) \{\n    var query = found.input.value.trim().toLowerCase(), shown = 0;\n    found.items.forEach(function (item) \{ var match = !query || item.textContent.toLowerCase().indexOf(query) >= 0; item.hidden = !match; if (match) shown += 1; \});\n    found.empty.hidden = shown > 0;\n  \}\n  function choose(root, found, item) \{\n    found.input.value = item.textContent;\n    found.items.forEach(function (other) \{ other.setAttribute('aria-selected', String(other === item)); \});\n    filter(found);\n    found.items.forEach(function (other) \{ other.hidden = false; \});\n    found.empty.hidden = true;\n    close(found);\n    found.input.focus();\n    found.input.dispatchEvent(new Event('change', \{ bubbles: true \}));\n  \}\n  function visible(found) \{ return found.items.filter(function (item) \{ return !item.hidden; \}); \}\n  document.addEventListener('input', function (event) \{\n    var root = event.target.closest('[data-slot=combobox]');\n    if (!root) return;\n    var found = parts(root);\n    open(root, found);\n    filter(found);\n  \});\n  document.addEventListener('click', function (event) \{\n    var root = event.target.closest('[data-slot=combobox]');\n    document.querySelectorAll('[data-slot=combobox]').forEach(function (other) \{ if (other !== root) close(parts(other)); \});\n    if (!root) return;\n    var found = parts(root), item = event.target.closest('[data-slot=combobox-item]');\n    if (item) return choose(root, found, item);\n    if (event.target.closest('button')) \{ isOpen(found) ? close(found) : (open(root, found), found.input.focus()); return; \}\n    open(root, found);\n  \});\n  document.addEventListener('keydown', function (event) \{\n    var root = event.target.closest('[data-slot=combobox]');\n    if (!root) return;\n    var found = parts(root), shown = visible(found), at = shown.indexOf(document.activeElement);\n    if (event.key === 'Escape') \{ close(found); found.input.focus(); return; \}\n    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') \{\n      event.preventDefault();\n      open(root, found);\n      if (shown.length) shown[event.key === 'ArrowDown' ? (at + 1) % shown.length : (at <= 0 ? shown.length : at) - 1].focus();\n    \}\n    if (event.key === 'Enter' && at >= 0) \{ event.preventDefault(); choose(root, found, shown[at]); \}\n  \});\n  addEventListener('resize', function () \{ document.querySelectorAll('[data-slot=combobox]').forEach(function (root) \{ var found = parts(root); if (isOpen(found)) place(root, found); \}); \});\n\})();"

/// Draws a code field's value into its cells.
export const OTP: Str = "(function () \{\n  if (window.fuiOtp) return;\n  window.fuiOtp = true;\n  function paint(root) \{\n    var input = root.querySelector('input'), slots = root.querySelectorAll('[data-slot=input-otp-slot]'), focused = document.activeElement === input, at = Math.min(input.value.length, slots.length - 1);\n    slots.forEach(function (slot, index) \{\n      slot.firstChild.textContent = input.value[index] || '';\n      slot.setAttribute('data-active', String(focused && index === at));\n      slot.toggleAttribute('data-caret', focused && index === input.value.length);\n    \});\n  \}\n  function rooted(event) \{ return event.target.matches && event.target.matches('[data-slot=input-otp-input]') ? event.target.closest('[data-slot=input-otp]') : null; \}\n  ['input', 'focusin', 'focusout', 'keyup', 'click'].forEach(function (name) \{\n    document.addEventListener(name, function (event) \{\n      var root = rooted(event);\n      if (!root) return;\n      if (name === 'input') event.target.value = event.target.value.replace(/[^0-9]/g, '');\n      if (name === 'click' || name === 'focusin') event.target.setSelectionRange(event.target.value.length, event.target.value.length);\n      paint(root);\n    \});\n  \});\n  document.querySelectorAll('[data-slot=input-otp]').forEach(paint);\n\})();"

/// Moves the line between two panels by pointer or arrow key.
export const RESIZABLE: Str = "(function () \{\n  if (window.fuiResizable) return;\n  window.fuiResizable = true;\n  var SMALLEST = 0.1;\n  function along(group) \{ return group.getAttribute('data-orientation') === 'vertical' ? 'height' : 'width'; \}\n  function shift(handle, moved) \{\n    var group = handle.parentElement, side = along(group), before = handle.previousElementSibling, after = handle.nextElementSibling;\n    var first = before.getBoundingClientRect()[side], second = after.getBoundingClientRect()[side], whole = first + second, smallest = whole * SMALLEST;\n    var next = Math.min(whole - smallest, Math.max(smallest, first + moved));\n    before.style.flexGrow = next;\n    after.style.flexGrow = whole - next;\n    handle.setAttribute('aria-valuenow', String(Math.round(next * 100 / whole)));\n  \}\n  document.addEventListener('pointerdown', function (event) \{\n    var handle = event.target.closest('[data-slot=resizable-handle]');\n    if (!handle) return;\n    event.preventDefault();\n    var vertical = along(handle.parentElement) === 'height', mirrored = !vertical && getComputedStyle(handle).direction === 'rtl', last = vertical ? event.clientY : event.clientX;\n    handle.setPointerCapture(event.pointerId);\n    function move(change) \{\n      var now = vertical ? change.clientY : change.clientX;\n      shift(handle, (now - last) * (mirrored ? -1 : 1));\n      last = now;\n    \}\n    function end() \{ handle.removeEventListener('pointermove', move); handle.removeEventListener('pointerup', end); handle.removeEventListener('pointercancel', end); \}\n    handle.addEventListener('pointermove', move);\n    handle.addEventListener('pointerup', end);\n    handle.addEventListener('pointercancel', end);\n  \});\n  document.addEventListener('keydown', function (event) \{\n    if (!event.target.matches('[data-slot=resizable-handle]')) return;\n    var vertical = along(event.target.parentElement) === 'height', STEP = 16;\n    var moves = vertical ? \{ ArrowUp: -STEP, ArrowDown: STEP \} : \{ ArrowLeft: -STEP, ArrowRight: STEP \};\n    if (!(event.key in moves)) return;\n    event.preventDefault();\n    shift(event.target, moves[event.key]);\n  \});\n\})();"

/// Moves a calendar's selection and follows its month and year lists.
export const CALENDAR: Str = "(function () \{\n  if (window.fuiCalendar) return;\n  window.fuiCalendar = true;\n  document.addEventListener('change', function (event) \{\n    if (!event.target.matches('[data-slot=calendar-dropdown]')) return;\n    var picked = event.target.selectedOptions[0];\n    if (event.target.value !== '#') \{ location.assign(event.target.value); return; \}\n    event.target.nextElementSibling.firstChild.textContent = picked.getAttribute('data-short') || picked.textContent;\n  \});\n  document.addEventListener('click', function (event) \{\n    var day = event.target.closest('[data-slot=calendar-day]');\n    if (!day || day.getAttribute('href') !== '#') return;\n    event.preventDefault();\n    day.closest('[data-slot=calendar]').querySelectorAll('[data-selected]').forEach(function (other) \{ other.removeAttribute('data-selected'); \});\n    day.setAttribute('data-selected', 'true');\n  \});\n\})();"

/// Puts the day chosen in a date picker's calendar into its field and label.
export const DATE_PICKER: Str = "(function () \{\n  if (window.fuiDatePicker) return;\n  window.fuiDatePicker = true;\n  document.addEventListener('click', function (event) \{\n    var day = event.target.closest('[data-slot=date-picker] [data-slot=calendar-day]');\n    if (!day || !day.hasAttribute('data-date')) return;\n    event.preventDefault();\n    var root = day.closest('[data-slot=date-picker]'), trigger = root.querySelector('[data-part=date-picker-trigger]');\n    root.querySelector('input[type=hidden]').value = day.getAttribute('data-date');\n    trigger.firstElementChild.textContent = new Date(day.getAttribute('data-date') + 'T00:00').toLocaleDateString(document.documentElement.lang || undefined, \{ month: 'long', day: 'numeric', year: 'numeric' \});\n    trigger.removeAttribute('data-empty');\n    root.querySelectorAll('[data-selected]').forEach(function (other) \{ other.removeAttribute('data-selected'); \});\n    day.setAttribute('data-selected', 'true');\n    day.closest('[popover]').hidePopover();\n    trigger.focus();\n  \});\n\})();"

/// Moves through an open menu with the arrow, Home, End, and letter keys.
export const MENU_KEYS: Str = "(function () \{\n  if (window.fuiMenuKeys) return;\n  window.fuiMenuKeys = true;\n  var keyboard = false;\n  document.addEventListener('pointerdown', function () \{ keyboard = false; \}, true);\n  document.addEventListener('keydown', function () \{ keyboard = true; \}, true);\n  var ITEMS = '[data-slot=dropdown-menu-item],[data-slot=context-menu-item]';\n  function entries(menu) \{ return Array.prototype.slice.call(menu.querySelectorAll(ITEMS)).filter(function (item) \{ return !item.disabled && item.closest('[role=menu]') === menu; \}); \}\n  document.addEventListener('toggle', function (event) \{\n    if (event.newState !== 'open' || !event.target.matches || !event.target.matches('[role=menu]')) return;\n    var first = entries(event.target)[0];\n    if (keyboard && first) \{ first.focus(\{ preventScroll: true \}); return; \}\n    event.target.setAttribute('tabindex', '-1');\n    event.target.style.outline = 'none';\n    event.target.focus(\{ preventScroll: true \});\n  \}, true);\n  document.addEventListener('keydown', function (event) \{\n    var menu = event.target.closest && event.target.closest('[role=menu]');\n    if (!menu) return;\n    var list = entries(menu), at = list.indexOf(document.activeElement), next = -1;\n    if (event.key === 'ArrowDown') next = (at + 1) % list.length;\n    if (event.key === 'ArrowUp') next = (at <= 0 ? list.length : at) - 1;\n    if (event.key === 'Home') next = 0;\n    if (event.key === 'End') next = list.length - 1;\n    if (next < 0 && event.key.length === 1 && !event.metaKey && !event.ctrlKey) \{\n      var letter = event.key.toLowerCase();\n      next = list.findIndex(function (item) \{ return item.textContent.trim().toLowerCase().indexOf(letter) === 0; \});\n      if (next < 0) return;\n    \}\n    if (next < 0) return;\n    event.preventDefault();\n    list[next].focus();\n  \});\n\})();"

/// Selects every row from the heading checkbox and counts what is chosen.
export const DATA_TABLE: Str = "(function () \{\n  if (window.fuiDataTable) return;\n  window.fuiDataTable = true;\n  function rows(root) \{ return Array.prototype.slice.call(root.querySelectorAll('tbody [data-slot=checkbox]')); \}\n  function count(root) \{\n    var boxes = rows(root), chosen = boxes.filter(function (box) \{ return box.checked; \}).length, all = root.querySelector('thead [data-slot=checkbox]'), text = root.parentElement.querySelector('[data-slot=data-table-count]');\n    if (all) \{ all.checked = boxes.length > 0 && chosen === boxes.length; all.indeterminate = chosen > 0 && chosen < boxes.length; \}\n    if (text) text.textContent = chosen + ' of ' + boxes.length + ' row(s) selected.';\n    boxes.forEach(function (box) \{ box.closest('tr').toggleAttribute('data-selected', box.checked); \});\n  \}\n  document.addEventListener('change', function (event) \{\n    var root = event.target.closest && event.target.closest('[data-slot=data-table]');\n    if (!root || !event.target.matches('[data-slot=checkbox]')) return;\n    if (event.target.closest('thead')) rows(root).forEach(function (box) \{ box.checked = event.target.checked; \});\n    count(root);\n  \});\n\})();"

/// Keeps one command highlighted and moves it with the arrow keys.
export const COMMAND_KEYS: Str = "(function () \{\n  if (window.fuiCommandKeys) return;\n  window.fuiCommandKeys = true;\n  function shown(root) \{ return Array.prototype.slice.call(root.querySelectorAll('[data-slot=command-item]:not([hidden]):not(:disabled)')); \}\n  function showInList(item) \{\n    var list = item.closest('[data-slot=command-list]'), box = list.getBoundingClientRect(), row = item.getBoundingClientRect();\n    if (row.top < box.top) list.scrollTop -= box.top - row.top;\n    if (row.bottom > box.bottom) list.scrollTop += row.bottom - box.bottom;\n  \}\n  function mark(root, item, reveal) \{\n    root.querySelectorAll('[data-selected]').forEach(function (other) \{ other.removeAttribute('data-selected'); \});\n    if (!item) return;\n    item.setAttribute('data-selected', 'true');\n    if (reveal) reveal(item);\n  \}\n  document.querySelectorAll('[data-slot=command]').forEach(function (root) \{ mark(root, shown(root)[0]); \});\n  document.addEventListener('input', function (event) \{\n    if (!event.target.matches('[data-slot=command-input]')) return;\n    var root = event.target.closest('[data-slot=command]');\n    mark(root, shown(root)[0]);\n  \});\n  document.addEventListener('pointermove', function (event) \{\n    var item = event.target.closest && event.target.closest('[data-slot=command-item]:not(:disabled)');\n    if (item) mark(item.closest('[data-slot=command]'), item);\n  \});\n  document.addEventListener('keydown', function (event) \{\n    if (!event.target.matches('[data-slot=command-input]')) return;\n    var root = event.target.closest('[data-slot=command]'), list = shown(root), at = list.indexOf(root.querySelector('[data-selected]'));\n    if (event.key === 'ArrowDown' && list.length) \{ event.preventDefault(); mark(root, list[(at + 1) % list.length], showInList); \}\n    if (event.key === 'ArrowUp' && list.length) \{ event.preventDefault(); mark(root, list[(at <= 0 ? list.length : at) - 1], showInList); \}\n    if (event.key === 'Enter' && at >= 0) \{ event.preventDefault(); list[at].click(); \}\n  \});\n\})();"
