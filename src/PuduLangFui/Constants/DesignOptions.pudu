/// What separates the parts of a design code.
export const CODE_SEPARATOR: Str = "."

/// How many parts a design code has.
export const CODE_PARTS: Int = 10

/// The slots a menu's coloring reaches.
export const MENU_SLOTS: Array[Str] = ["dropdown-menu", "context-menu", "menubar-menu"]

/// The declarations of an inverted menu.
export const MENU_INVERTED: Str = "color-scheme: dark"

/// The declarations of a translucent menu.
export const MENU_TRANSLUCENT: Str = "background-color: color-mix(in oklab, var(--fui-popover) 70%, transparent); backdrop-filter: blur(40px) saturate(150%)"

/// The declarations of a boldly highlighted menu.
export const MENU_BOLD: Str = "--fui-accent: var(--fui-primary); --fui-accent-foreground: var(--fui-primary-foreground)"
