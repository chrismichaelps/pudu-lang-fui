/** @Fui.Constants.ToastScript.Module — what a toast region does in a page */
module PuduLangFui.Constants.ToastScript

/// The script, one line per entry.
export const LINES: Array[Str] = [
  "(function () \{",
  "  var LIFETIME = 4000, SWIPE_THRESHOLD = 45, SWIPE_VELOCITY = 0.11, UNMOUNT = 200, HISTORY = 100;",
  "  var history = [], counter = 1, states = new WeakMap();",
  "  function regions() \{ return Array.prototype.slice.call(document.querySelectorAll('[data-slot=toast-region]')); \}",
  "  function toastsIn(region) \{ return Array.prototype.slice.call(region.children).filter(function (n) \{ return n.matches('[data-slot=toast]') && n.dataset.removed !== 'true'; \}); \}",
  "  function number(value, fallback) \{ var parsed = parseFloat(value); return isNaN(parsed) ? fallback : parsed; \}",
  "  function stateOf(region) \{",
  "    var state = states.get(region);",
  "    if (!state) \{ state = \{ expanded: false, interacting: false, timers: [] \}; states.set(region, state); \}",
  "    return state;",
  "  \}",
  "  function expandedOf(region) \{ return region.dataset.expand === 'true' || stateOf(region).expanded; \}",
  "  function layout(region) \{",
  "    var items = toastsIn(region).reverse(), gap = number(region.dataset.gap, 14), visible = number(region.dataset.visible, 3), expanded = expandedOf(region), sum = 0, front = 0;",
  "    region.dataset.managed = 'true';",
  "    items.forEach(function (toast, index) \{",
  "      var previous = toast.style.height;",
  "      toast.style.height = 'auto';",
  "      var height = toast.getBoundingClientRect().height;",
  "      toast.style.height = previous;",
  "      toast.dataset.height = String(height);",
  "      if (index === 0) front = height;",
  "      toast.style.setProperty('--index', index);",
  "      toast.style.setProperty('--toasts-before', index);",
  "      toast.style.setProperty('--z-index', items.length - index);",
  "      toast.style.setProperty('--offset', (index * gap + sum) + 'px');",
  "      toast.style.setProperty('--initial-height', region.dataset.expand === 'true' ? 'auto' : height + 'px');",
  "      toast.dataset.front = String(index === 0);",
  "      toast.dataset.visible = String(index + 1 <= visible);",
  "      toast.dataset.expanded = String(expanded);",
  "      sum += height;",
  "    \});",
  "    region.style.setProperty('--front-toast-height', front + 'px');",
  "    region.style.setProperty('--toast-gap', gap + 'px');",
  "    region.style.setProperty('--stack-height', (expanded ? sum + gap * Math.max(items.length - 1, 0) : front) + 'px');",
  "  \}",
  "  function remove(toast, callback) \{",
  "    if (!toast || toast.dataset.removed === 'true') return;",
  "    var region = toast.parentElement;",
  "    toast.dataset.removed = 'true';",
  "    setTimeout(function () \{ toast.remove(); if (region) layout(region); \}, UNMOUNT);",
  "    if (region) layout(region);",
  "    if (callback) callback(toast.fuiRecord);",
  "    toast.dispatchEvent(new CustomEvent('fui-toast-close', \{ bubbles: true \}));",
  "  \}",
  "  function arm(toast) \{",
  "    if (toast.dataset.armed) return;",
  "    toast.dataset.armed = '1';",
  "    var region = toast.parentElement, record = toast.fuiRecord;",
  "    var duration = record && record.duration != null ? record.duration : number(toast.dataset.duration, number(region.dataset.duration, LIFETIME));",
  "    if (toast.dataset.kind !== 'loading' && duration > 0 && duration !== Infinity) stateOf(region).timers.push(\{ toast: toast, left: duration, at: Date.now() \});",
  "    requestAnimationFrame(function () \{ toast.dataset.mounted = 'true'; layout(region); \});",
  "  \}",
  "  setInterval(function () \{",
  "    regions().forEach(function (region) \{",
  "      var state = stateOf(region), paused = expandedOf(region) || state.interacting || document.hidden, now = Date.now();",
  "      state.timers = state.timers.filter(function (timer) \{",
  "        if (paused) \{ timer.at = now; return true; \}",
  "        timer.left -= now - timer.at;",
  "        timer.at = now;",
  "        if (timer.left > 0) return true;",
  "        var record = timer.toast.fuiRecord;",
  "        remove(timer.toast, record && record.onAutoClose);",
  "        return false;",
  "      \});",
  "    \});",
  "  \}, 50);",
  "  function directionsOf(toast) \{",
  "    var region = toast.parentElement;",
  "    if (region.dataset.swipe) return region.dataset.swipe.split(',');",
  "    return (region.dataset.position || 'bottom-end').split('-').map(function (word) \{ return word === 'end' ? 'right' : word === 'start' ? 'left' : word; \});",
  "  \}",
  "  function dampen(delta) \{ return delta * (1 / (1.5 + Math.abs(delta) / 20)); \}",
  "  var swipe = null;",
  "  document.addEventListener('pointerdown', function (event) \{",
  "    var region = event.target.closest && event.target.closest('[data-slot=toast-region]');",
  "    if (region && !event.target.closest('[data-dismissible=false]')) \{ stateOf(region).interacting = true; layout(region); \}",
  "    var toast = event.target.closest && event.target.closest('[data-slot=toast]');",
  "    if (!toast || event.button === 2 || toast.dataset.dismissible === 'false' || toast.dataset.kind === 'loading') return;",
  "    if (event.target.closest('button')) return;",
  "    event.target.setPointerCapture(event.pointerId);",
  "    toast.dataset.swiping = 'true';",
  "    swipe = \{ toast: toast, x: event.clientX, y: event.clientY, axis: null, time: Date.now() \};",
  "  \});",
  "  document.addEventListener('pointermove', function (event) \{",
  "    if (!swipe || (window.getSelection() && window.getSelection().toString().length > 0)) return;",
  "    var x = event.clientX - swipe.x, y = event.clientY - swipe.y, allowed = directionsOf(swipe.toast);",
  "    if (!swipe.axis && (Math.abs(x) > 1 || Math.abs(y) > 1)) swipe.axis = Math.abs(x) > Math.abs(y) ? 'x' : 'y';",
  "    var amountX = 0, amountY = 0;",
  "    if (swipe.axis === 'y') amountY = (allowed.indexOf('top') >= 0 && y < 0) || (allowed.indexOf('bottom') >= 0 && y > 0) ? y : dampen(y);",
  "    if (swipe.axis === 'x') amountX = (allowed.indexOf('left') >= 0 && x < 0) || (allowed.indexOf('right') >= 0 && x > 0) ? x : dampen(x);",
  "    if (amountX || amountY) swipe.toast.dataset.swiped = 'true';",
  "    swipe.toast.style.setProperty('--swipe-amount-x', amountX + 'px');",
  "    swipe.toast.style.setProperty('--swipe-amount-y', amountY + 'px');",
  "  \});",
  "  document.addEventListener('pointerup', function () \{",
  "    regions().forEach(function (region) \{ stateOf(region).interacting = false; \});",
  "    if (!swipe) return;",
  "    var toast = swipe.toast, x = parseFloat(toast.style.getPropertyValue('--swipe-amount-x')) || 0, y = parseFloat(toast.style.getPropertyValue('--swipe-amount-y')) || 0;",
  "    var amount = swipe.axis === 'x' ? x : y, velocity = Math.abs(amount) / Math.max(Date.now() - swipe.time, 1), allowed = directionsOf(toast);",
  "    var permitted = swipe.axis === 'x' ? allowed.indexOf(x > 0 ? 'right' : 'left') >= 0 : allowed.indexOf(y > 0 ? 'bottom' : 'top') >= 0;",
  "    toast.dataset.swiping = 'false';",
  "    if (swipe.axis && permitted && (Math.abs(amount) >= SWIPE_THRESHOLD || velocity > SWIPE_VELOCITY)) \{",
  "      toast.dataset.swipeDirection = swipe.axis === 'x' ? (x > 0 ? 'right' : 'left') : (y > 0 ? 'down' : 'up');",
  "      toast.dataset.swipeOut = 'true';",
  "      remove(toast, toast.fuiRecord && toast.fuiRecord.onDismiss);",
  "    \} else \{",
  "      toast.style.setProperty('--swipe-amount-x', '0px');",
  "      toast.style.setProperty('--swipe-amount-y', '0px');",
  "      toast.dataset.swiped = 'false';",
  "    \}",
  "    swipe = null;",
  "  \});",
  "  function hover(event) \{",
  "    var region = event.currentTarget, state = stateOf(region), next = event.type !== 'mouseleave' || state.interacting;",
  "    if (state.expanded !== next) \{ state.expanded = next; layout(region); \}",
  "  \}",
  "  function watch(region) \{",
  "    if (region.dataset.watched) return;",
  "    region.dataset.watched = '1';",
  "    region.addEventListener('mouseenter', hover);",
  "    region.addEventListener('mousemove', hover);",
  "    region.addEventListener('mouseleave', hover);",
  "    toastsIn(region).forEach(arm);",
  "    layout(region);",
  "  \}",
  "  document.addEventListener('keydown', function (event) \{",
  "    regions().forEach(function (region) \{",
  "      var keys = (region.dataset.hotkey || 'altKey,KeyT').split(',');",
  "      if (keys.every(function (key) \{ return event[key] || event.code === key; \})) \{ stateOf(region).expanded = true; layout(region); region.focus(); \}",
  "      if (event.code === 'Escape' && region.contains(document.activeElement)) \{ stateOf(region).expanded = false; layout(region); \}",
  "    \});",
  "  \});",
  "  document.addEventListener('close', function (event) \{",
  "    if (!event.target.matches('[data-slot=toast]')) return;",
  "    var toast = event.target, region = toast.parentElement, record = toast.fuiRecord;",
  "    toast.setAttribute('open', 'open');",
  "    remove(toast, record && record.onDismiss);",
  "    if (region) layout(region);",
  "  \}, true);",
  "  function regionFor(options) \{",
  "    var all = regions(), wanted = options.toasterId, position = options.position;",
  "    var base = all.filter(function (r) \{ return !wanted || r.dataset.toaster === wanted; \})[0];",
  "    if (!base || !position || base.dataset.position === position) return base;",
  "    var match = all.filter(function (r) \{ return r.dataset.position === position && (!wanted || r.dataset.toaster === wanted); \})[0];",
  "    if (match) return match;",
  "    var copy = base.cloneNode(false);",
  "    copy.removeAttribute('data-watched');",
  "    copy.dataset.position = position;",
  "    copy.appendChild(base.querySelector('template').cloneNode(true));",
  "    base.parentElement.appendChild(copy);",
  "    watch(copy);",
  "    return copy;",
  "  \}",
  "  function textOf(value) \{ return typeof value === 'function' ? value() : value; \}",
  "  function button(host, slot, spec, toast) \{",
  "    var node = document.createElement('button');",
  "    node.type = 'button';",
  "    node.setAttribute('data-slot', slot);",
  "    node.textContent = spec.label;",
  "    node.addEventListener('click', function (event) \{",
  "      if (spec.onClick) spec.onClick(event);",
  "      if (!event.defaultPrevented) remove(toast, toast.fuiRecord.onDismiss);",
  "    \});",
  "    host.appendChild(node);",
  "  \}",
  "  function fill(toast, record, region) \{",
  "    var message = toast.querySelector('[data-slot=toast-message]'), description = toast.querySelector('[data-slot=toast-description]'), glyph = toast.querySelector('template[data-kind=\"' + record.type + '\"]');",
  "    message.textContent = textOf(record.title) || '';",
  "    description.textContent = textOf(record.description) || '';",
  "    description.hidden = !record.description;",
  "    toast.dataset.kind = record.type || 'neutral';",
  "    toast.dataset.dismissible = String(record.dismissible !== false);",
  "    if (record.richColors != null) toast.dataset.rich = String(record.richColors);",
  "    if (record.invert) toast.dataset.inverted = 'true';",
  "    if (record.promise) toast.dataset.promise = 'true';",
  "    if (record.className) toast.className = record.className;",
  "    var holder = toast.querySelector('[data-slot=toast-icon]');",
  "    if (record.icon === null) holder.hidden = true;",
  "    else if (record.icon) holder.innerHTML = record.icon;",
  "    else \{ var source = region.querySelector('template[data-glyph=\"' + (record.type || 'neutral') + '\"]'); if (source) holder.innerHTML = source.innerHTML; \}",
  "    toast.querySelectorAll('[data-slot=toast-action],[data-slot=toast-cancel],[data-slot=toast-close]').forEach(function (n) \{ n.remove(); \});",
  "    if (record.cancel) button(toast, 'toast-cancel', record.cancel, toast);",
  "    if (record.action) button(toast, 'toast-action', record.action, toast);",
  "    if ((record.closeButton != null ? record.closeButton : region.dataset.closable === 'true') && record.type !== 'loading') \{",
  "      var close = document.createElement('button');",
  "      close.type = 'button';",
  "      close.setAttribute('data-slot', 'toast-close');",
  "      close.setAttribute('aria-label', 'Close toast');",
  "      close.innerHTML = '<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg>';",
  "      close.addEventListener('click', function () \{ remove(toast, record.onDismiss); \});",
  "      toast.appendChild(close);",
  "    \}",
  "  \}",
  "  function create(title, options, type) \{",
  "    var opts = options || \{\}, region = regionFor(opts);",
  "    if (!region) return undefined;",
  "    var id = opts.id != null ? opts.id : counter++, existing = null;",
  "    regions().forEach(function (r) \{ toastsIn(r).forEach(function (t) \{ if (t.fuiRecord && t.fuiRecord.id === id) existing = t; \}); \});",
  "    var record = Object.assign(\{\}, existing ? existing.fuiRecord : \{\}, opts, \{ id: id, title: title, type: type || opts.type \});",
  "    var toast = existing;",
  "    if (!toast) \{",
  "      toast = region.querySelector('template[data-slot=toast-template]').content.firstElementChild.cloneNode(true);",
  "      toast.fuiRecord = record;",
  "      region.appendChild(toast);",
  "      history.push(record);",
  "      if (history.length > HISTORY) history.shift();",
  "    \}",
  "    toast.fuiRecord = record;",
  "    if (opts.custom) \{ toast.innerHTML = opts.custom; toast.dataset.custom = 'true'; \} else fill(toast, record, region);",
  "    if (existing) \{",
  "      delete toast.dataset.armed;",
  "      var state = stateOf(toast.parentElement);",
  "      state.timers = state.timers.filter(function (timer) \{ return timer.toast !== toast; \});",
  "    \}",
  "    arm(toast);",
  "    layout(region);",
  "    return id;",
  "  \}",
  "  function kind(type) \{ return function (title, options) \{ return create(title, options, type); \}; \}",
  "  function api(title, options) \{ return create(title, options, options && options.type); \}",
  "  api.success = kind('success');",
  "  api.info = kind('info');",
  "  api.warning = kind('warning');",
  "  api.error = kind('failure');",
  "  api.loading = kind('loading');",
  "  api.message = function (title, options) \{ return create(title, options); \};",
  "  api.custom = function (markup, options) \{ return create('', Object.assign(\{\}, options, \{ custom: markup \})); \};",
  "  api.dismiss = function (id) \{",
  "    regions().forEach(function (region) \{ toastsIn(region).forEach(function (toast) \{ if (id == null || (toast.fuiRecord && toast.fuiRecord.id === id) || toast.id === id) remove(toast, toast.fuiRecord && toast.fuiRecord.onDismiss); \}); \});",
  "    return id;",
  "  \};",
  "  api.promise = function (promise, data) \{",
  "    var options = data || \{\}, id = create(options.loading, Object.assign(\{\}, options, \{ promise: true, loading: undefined, success: undefined, error: undefined, duration: Infinity \}), 'loading');",
  "    function settle(type, label, value) \{",
  "      var title = typeof label === 'function' ? label(value) : label;",
  "      if (title === undefined) \{ api.dismiss(id); return; \}",
  "      create(title, Object.assign(\{\}, options, \{ id: id, duration: options.duration == null ? LIFETIME : options.duration, description: typeof options.description === 'function' ? options.description(value) : options.description, loading: undefined, success: undefined, error: undefined \}), type);",
  "    \}",
  "    var running = Promise.resolve(typeof promise === 'function' ? promise() : promise);",
  "    running.then(function (value) \{ settle('success', options.success, value); \}, function (reason) \{ settle('failure', options.error, reason); \}).finally(function () \{ if (options.finally) options.finally(); \});",
  "    return Object.assign(id, \{ unwrap: function () \{ return running; \} \});",
  "  \};",
  "  api.getHistory = function () \{ return history.slice(); \};",
  "  api.getToasts = function () \{",
  "    var found = [];",
  "    regions().forEach(function (region) \{ toastsIn(region).forEach(function (toast) \{ if (toast.fuiRecord) found.push(toast.fuiRecord); \}); \});",
  "    return found;",
  "  \};",
  "  window.fuiToast = api;",
  "  function start() \{ regions().forEach(watch); \}",
  "  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();",
  "  addEventListener('resize', function () \{ regions().forEach(layout); \});",
  "\})();"
]
