/** @Fui.Constants.LookBase.Module — what every look's rules rely on */
module PuduLangFui.Constants.LookBase

/// Initial values of the variables the looks compose.
export const INITIAL: Str = "[data-slot], [data-slot]::before, [data-slot]::after, [data-slot]::backdrop \{ border-color: var(--fui-border); outline-color: color-mix(in oklab, var(--fui-ring) 50%, transparent); --fui-u-animation-delay: 0s; --fui-u-animation-direction: normal; --fui-u-animation-fill-mode: none; --fui-u-animation-iteration-count: 1; --fui-u-enter-blur: 0; --fui-u-enter-opacity: 1; --fui-u-enter-rotate: 0; --fui-u-enter-scale: 1; --fui-u-enter-translate-x: 0; --fui-u-enter-translate-y: 0; --fui-u-exit-blur: 0; --fui-u-exit-opacity: 1; --fui-u-exit-rotate: 0; --fui-u-exit-scale: 1; --fui-u-exit-translate-x: 0; --fui-u-exit-translate-y: 0; --fui-u-shadow: 0 0 #0000; --fui-u-shadow-alpha: 100%; --fui-u-inset-shadow: 0 0 #0000; --fui-u-inset-shadow-alpha: 100%; --fui-u-ring-shadow: 0 0 #0000; --fui-u-inset-ring-shadow: 0 0 #0000; --fui-u-ring-offset-width: 0px; --fui-u-ring-offset-color: #fff; --fui-u-ring-offset-shadow: 0 0 #0000; --fui-u-border-style: solid; --fui-u-content: \"\"; --fui-u-translate-x: 0; --fui-u-translate-y: 0; --fui-u-translate-z: 0; --fui-u-outline-style: solid; --fui-u-scale-x: 1; --fui-u-scale-y: 1; --fui-u-scale-z: 1; --fui-u-scroll-snap-strictness: proximity; --fui-u-space-x-reverse: 0; --fui-u-scrollbar-thumb: #0000; --fui-u-scrollbar-track: #0000; \}"

/// The animations the looks use.
export const FRAMES: Str = "@keyframes pulse \{ 50% \{ opacity: 0.5; \} \} @keyframes enter \{ from \{ opacity: var(--fui-u-enter-opacity,1); transform: translate3d(var(--fui-u-enter-translate-x,0),var(--fui-u-enter-translate-y,0),0)scale3d(var(--fui-u-enter-scale,1),var(--fui-u-enter-scale,1),var(--fui-u-enter-scale,1))rotate(var(--fui-u-enter-rotate,0)); filter: blur(var(--fui-u-enter-blur,0)); \} \} @keyframes exit \{ to \{ opacity: var(--fui-u-exit-opacity,1); transform: translate3d(var(--fui-u-exit-translate-x,0),var(--fui-u-exit-translate-y,0),0)scale3d(var(--fui-u-exit-scale,1),var(--fui-u-exit-scale,1),var(--fui-u-exit-scale,1))rotate(var(--fui-u-exit-rotate,0)); filter: blur(var(--fui-u-exit-blur,0)); \} \} @keyframes caret-blink \{ 0%,70%,100% \{ opacity: 1; \} 20%,50% \{ opacity: 0; \} \}"
