/** @Test.Theme.ThemeTest.Suite — aspects, presets, and the audit */
module PuduLangFui.Theme.ThemeTest

import Std.Io as Io
import Std.List as List
import Std.Result as Result
import Std.Test as Test
import PuduLangFui.Domain.Color as Color
import PuduLangFui.Theme.Aspects.Palette as Palette
import PuduLangFui.Theme.Aspects.Spacing as Spacing
import PuduLangFui.Theme.Audit.Contrast as Contrast
import PuduLangFui.Theme.Build.Theme as Theme
import PuduLangFui.Theme.Looks.Catalog as Looks
import PuduLangFui.Theme.Presets.Design as Design
import PuduLangFui.Theme.Presets.Preset as Preset

/// How many times a piece of text appears.
fn occurrences(text: &Str, piece: Str) -> Int { text.split(piece).length() - 1 }

/// Whether every selector of a look closes what it opens, so no rule swallows those after it.
fn balancedLook(name: Str) -> Bool {
  match Looks.named(name) {
    case None => false
    case Some(rules) => {
      var balanced = true

      for rule in rules {
        if occurrences(&rule[1], "(") != occurrences(&rule[1], ")") { balanced = false }
      }

      balanced
    }
  }
}

/// The value of a token, or nothing.
fn valueOf(theme: &Theme.Theme, name: Str) -> Option[Str] {
  let found = List.find(&Theme.tokens(theme), |entry: (Str, Str)| entry[0] == name) ?

  Some(found[1])
}

/// Every finding across the named presets.
fn presetFindings() -> Array[Str] {
  var found: Array[Str] = []

  for name in Preset.names() {
    if let Ok(preset) = Preset.named(name) {
      for finding in Contrast.audit(&Preset.theme(&preset).color) {
        found = found.push(name + ": " + finding.pairing + " " + finding.mode + " " + show(finding.ratio))
      }
    }
  }

  found
}

/// Every finding across a sweep of hues.
fn sweepFindings() -> Array[Str] {
  var found: Array[Str] = []
  var hue = 0.0

  while hue < 360.0 {
    for finding in Contrast.audit(&Palette.derived(hue, 0.14)) {
      found = found.push(show(hue) + ": " + finding.pairing + " " + finding.mode + " " + show(finding.ratio))
    }

    hue = hue + 30.0
  }

  found
}

/// Runs the suite.
fn main() -> Int {
  let base = Theme.defaults()
  let tuned = base.radius("0").density(Spacing.Compact).fonts("Inter", "Serif").textBase("15px").iconStroke("1.5").token("brand-glow", "red")
  let code = "h264-c14-r10-compact-gentle"
  let unreadable = Palette.Palette{..Palette.derived(0.0, 0.0), foreground: Color.pair(Color.oklch(1.0, 0.0, 0.0), Color.oklch(0.16, 0.0, 0.0))}
  let checks = Test.suite("Theme", &[
      Test.that("a design code round-trips", Design.decode(Design.encode(&Design.initial())) == Ok(Design.initial())),
      Test.that("a design code needs every part", Result.isErr(&Design.decode("gentle.neutral"))),
      Test.that("a design code refuses an unknown part", Result.isErr(&Design.decode("gentle.neutral.neutral.neutral.lucide.nope.inherit.default.default.subtle"))),
      Test.that("a chosen theme colors the primary", Theme.render(&Design.theme(&Design.Design{..Design.initial(), theme: "blue"})).contains("--fui-primary: light-dark(")),
      Test.that("a chart color reaches the charts", Theme.render(&Design.theme(&Design.Design{..Design.initial(), chart: "rose"})).contains("--fui-chart-1: light-dark(")),
      Test.that("an inverted menu is dark", Design.menuColorRules("inverted")[0][2].contains("color-scheme: dark")),
      Test.that("a default menu adds nothing", Design.menuColorRules("default").isEmpty()),
      Test.that("a bold accent adds a rule", !Design.menuAccentRules("bold").isEmpty()),
      Test.that("a preset name still picks a theme", Result.isOk(&Design.themeFor("graphite"))),
      Test.that("a design code picks a theme", Result.isOk(&Design.themeFor(Design.encode(&Design.initial())))),
      Test.that("every look is well formed", Looks.names().filter(|name: Str| !balancedLook(name)).isEmpty()),
      Test.that("an unknown look is absent", Looks.named("missing") == None),
      Test.that("a color token comes from its field", valueOf(&base, "primary-foreground") != None),
      Test.that("a digit field keeps its number", valueOf(&base, "chart-1") != None),
      Test.equals("the radius sets the base", &valueOf(&tuned, "radius"), &Some("0")),
      Test.equals("density sets the unit", &valueOf(&tuned, "unit"), &Some("0.2rem")),
      Test.equals("fonts set the family", &valueOf(&tuned, "font-sans"), &Some("Inter")),
      Test.equals("the heading has its own family", &valueOf(&tuned, "font-heading"), &Some("Serif")),
      Test.equals("the base size is set", &valueOf(&tuned, "text-base"), &Some("15px")),
      Test.equals("the icon stroke is set", &valueOf(&tuned, "icon-stroke"), &Some("1.5")),
      Test.equals("a project token is added", &valueOf(&tuned, "brand-glow"), &Some("red")),
      Test.that("the theme follows the color scheme", Theme.render(&base).contains("color-scheme: light dark")),
      Test.that("a mode can be forced", Theme.render(&base).contains("[data-mode=\"dark\"]")),
      Test.that("colors follow the mode", Theme.render(&base).contains("light-dark(")),
      Test.that("a region can be themed", Theme.renderScoped(&base, ".brand").contains(".brand \{")),
      Test.equals("every named preset is legible", &presetFindings(), &[]),
      Test.equals("every hue stays legible", &sweepFindings(), &[]),
      Test.that("the audit finds an unreadable pairing", Contrast.audit(&unreadable).length() > 0),
      Test.equals("a code round trips", &Result.unwrapOr(Result.map(Preset.decode(code), |preset: Preset.Preset| Preset.encode(&preset)), ""), &code),
      Test.that("a code is accepted by name lookup", Preset.named(code) == Preset.decode(code)),
      Test.that("a partial code is refused", Result.isErr(&Preset.decode("h1-c2"))),
      Test.that("a hue past the circle is refused", Result.isErr(&Preset.decode("h400-c14-r10-compact"))),
      Test.that("a chroma out of range is refused", Result.isErr(&Preset.decode("h200-c90-r10-compact"))),
      Test.that("a non-number is refused", Result.isErr(&Preset.decode("hx-c14-r10-compact"))),
      Test.that("an unknown density is refused", Result.isErr(&Preset.decode("h200-c14-r10-huge"))),
      Test.that("an unknown name is refused", Result.isErr(&Preset.named("nope")))
    ])
  let report = Test.run(&checks)

  for failure in Test.failuresOf(&report) {
    let _reported = Io.writeErrorLine(failure)
  }

  Test.report(&report)
}
