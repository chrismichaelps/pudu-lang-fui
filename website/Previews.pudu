fn demoAccordion() -> H.Node {
  column("24rem", [Accordion.accordion().holding([
          Accordion.item("faq", "Is it accessible?", true).holding([Accordion.content().says("Yes. It uses the platform's own disclosure element.")]),
          Accordion.item("faq", "Does it need a script?").holding([Accordion.content().says("No. Sections sharing a name open one at a time.")]),
          Accordion.item("faq", "Can I restyle it?").holding([Accordion.content().says("Add it to your project and edit the file.")])
        ])])
}

fn demoAlert() -> H.Node {
  column("28rem", [
      Alert.alert(Alert.Neutral).holding([Icon.icon(Icon.Info), Alert.title().says("Heads up"), Alert.description().says("You can add components with the generator.")]),
      Alert.alert(Alert.Destructive).holding([Icon.icon(Icon.ErrorCircle), Alert.title().says("Upload failed"), Alert.description().says("The file was too large.")])
    ])
}

fn demoAlertDialog() -> H.Node {
  H.div().holding([
      AlertDialog.trigger("erase", Button.props().variant(Button.Outline)).says("Delete account"),
      AlertDialog.alertDialog("erase", "Delete account").holding([
          AlertDialog.header().holding([AlertDialog.title().says("Are you sure?"), AlertDialog.description().says("This cannot be undone.")]),
          AlertDialog.footer().holding([AlertDialog.cancel("erase", Button.props().variant(Button.Outline)).says("Cancel"), AlertDialog.action("erase", Button.props()).says("Continue")])
        ])
    ])
}

fn demoAspectRatio() -> H.Node { AspectRatio.aspectRatio("16 / 9").css("inline-size", "20rem").css("background", "var(--fui-muted)").css("border-radius", "var(--fui-radius-xl)") }

