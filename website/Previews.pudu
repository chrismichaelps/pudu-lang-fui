              H.div().css("display", "flex").css("align-items", "center").css("gap", "var(--fui-space-2)").holding([Button.button(outline).says("Alert Dialog"), ButtonGroup.group(ButtonGroup.Horizontal).holding([Button.button(outline).says("Button Group"), Button.button(outline).label("More").holding([Icon.icon(Icon.ChevronUp)])]), Switch.switcher("s", true)])
            ])]),
      H.div().css("display", "flex").css("gap", "var(--fui-space-4)").css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding([
          navTile("Workspace", &[(Icon.File, "Documents"), (Icon.Folder, "Projects"), (Icon.Calendar, "Calendar")], 9),
          navTile("Account", &[(Icon.User, "Profile"), (Icon.Settings, "Settings"), (Icon.Star, "Favorites")], 1)
