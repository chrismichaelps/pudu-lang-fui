/// A padded card with the given children.
fn tile(children: Array[H.Node]) -> H.Node { Card.card().css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding(children) }

/// A navigation tile.
fn navTile(heading: Str, entries: &Array[(Icon.Glyph, Str)], active: Int) -> H.Node {
  var rows: Array[H.Node] = []
  var index = 0

  for entry in entries {
    rows = rows.push(Sidebar.menuItem().holding([Sidebar.menuButton("#", index == active).holding([Icon.icon(entry[0]), H.words(entry[1])])]))
    index = index + 1
  }

  Card.card().css("flex", "1").css("padding-block", "var(--fui-space-2)").holding([Sidebar.group().holding([Sidebar.groupLabel().says(heading), Sidebar.menu().holding(rows)])])
}

