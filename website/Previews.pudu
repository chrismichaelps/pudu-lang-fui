      tile([Card.header().holding([Card.title().says("Plan a release"), Card.description().says("Pick a target and we will pace the work.")]), Card.content().holding([Field.group().holding([Field.field().holding([Field.label("goal").says("Release name"), Input.input("goal", Input.props()).placeholder("e.g. Spring update")]), Button.button(Button.props()).says("Create plan"), Button.button(outline).says("Cancel")])])]),
      tile([Empty.empty().holding([Empty.media().holding([Icon.icon(Icon.Plus)]), Empty.title().says("Publish a package"), Empty.description().says("Share your first release with everyone using Pudu."), Empty.content().holding([Button.button(Button.props()).says("Create release")])])]),
      tile([Card.header().holding([Card.title().says("Traffic"), Card.description().says("418,200 visitors"), Card.action().holding([Button.button(Button.props().variant(Button.Outline).size(Button.Small)).says("View")])]), Card.content().holding([Chart.chart(Chart.Areas, "Visits", [Chart.series("Visits", [4.0, 7.0, 5.0, 3.0, 6.0, 6.0])])])]),
      tile([Card.header().holding([Card.title().says("Notifications"), Card.description().says("Choose what reaches you.")]), Card.content().holding([Field.group().holding([
                  Field.oriented(Field.Horizontal, false).holding([Checkbox.checkbox("n1", Checkbox.props().checked()), Field.content().holding([Field.title().says("Build alerts"), Field.description().says("Failures and recoveries.")])]),
                  Field.oriented(Field.Horizontal, false).holding([Checkbox.checkbox("n2", Checkbox.props().checked()), Field.content().holding([Field.title().says("Security alerts"), Field.description().says("Sign-ins and account changes.")])])
                ])])])
    ])
}

/// Writes a file, reporting a failure on the error stream.
fn saved(path: Str, text: Str) -> Bool {
  let _made = Io.makeDirectory(Path.directoryOf(path))

  match Io.write(path, text) {
    case Ok(_) => true
    case Err(problem) => {
      let _said = Io.writeErrorLine(path + ": " + problem)

      false
    }
  }
}

/// A standalone preview page holding one demonstration.
fn previewPage(title: Str, body: H.Node, blocks: &Array[Css.Block]) -> Str {
  Fui.document(&Fui.page(title, Theme.defaults(), *blocks), H.main().css("display", "flex").css("min-block-size", "100vh").css("align-items", "center").css("justify-content", "center").css("padding", "var(--fui-space-6)").holding([body]))
}

/// The text between a demonstration's signature and its end.
fn sourceOf(program: &Array[Str], name: Str) -> Str {
  let signature = "fn demo" + Spelling.pascal(name) + "() -> H.Node"
  var collected: Array[Str] = []
  var inside = false

  for text in program {
    if inside && text == "\}" { return collected.join("\n") }
    if inside { collected = collected.push(text.drop(2)) }
    if text.startsWith(signature) {
      if text.endsWith("\}") { return text.drop(signature.length() + 3).take(text.length() - signature.length() - 5) }

      inside = true
    }
  }

  collected.join("\n")
}

/// A description as a sentence.
fn sentence(text: Str) -> Str { text.take(1).toUpper() + text.drop(1) + "." }

/// An item's name as a title: words capitalized and spaced.
fn titled(name: Str) -> Str { name.split("-").map(|word: Str| Spelling.pascal(word)).join(" ") }

/// One item's documentation page.
fn pageOf(item: &Item.Item, source: Str, surface: &Array[Str]) -> Str {
  let title = titled(item.name)

  ["---", "title: " + title, "description: " + sentence(item.description), "---", "", "# " + title, "", sentence(item.description), "",
    "<div class=\"fui-preview\"><a href=\"../previews/" + item.name + ".html\">Open the " + title + " preview</a></div>", "",
    "## Installation", "", "```bash", "fui add " + item.name, "```", "",
    "## Usage", "", "```pudu", source, "```", "",
    "## API", "", "```pudu", surface.join("\n"), "```", ""].join("\n")
}

/// Exported signatures of a source, one declaration per line.
fn surfaceOf(source: Str) -> Array[Str] {
  source.split("\n").filter(|text: Str| text.startsWith("export ")).map(|text: Str| text.split(" \{ Core")[0].split(" \{ Button")[0].split(" \{ H.")[0].split(" \{ Props")[0].replace(" \{", ""))
}

/// A table of contents for one kind of item.
fn tocOf(items: &Array[Item.Item]) -> Str {
  var lines: Array[Str] = []

  for item in items {
    lines = lines.push("- name: " + titled(item.name)).push("  href: " + item.name + ".md")
  }

  lines.join("\n") + "\n"
}

/// Writes every preview and page; answers the number of problems.
fn main() -> Int {
  let registry = match Registry.load(".") {
    case Ok(found) => found
    case Err(problem) => panic(problem)
  }
  let program = Result.unwrapOr(Io.read("website/Previews.pudu"), "").split("\n")
  let blocks = Catalog.all()
  var failures = 0

  for item in registry.items {
    let folder = Option.unwrapOr(FOLDERS.get(show(item.kind)), "components")
    let surface = surfaceOf(Result.unwrapOr(Io.read(item.path), ""))

    match DEMOS.get(item.name) {
      case None => {
        let _said = Io.writeErrorLine("no demonstration for " + item.name)

        failures = failures + 1
      }
      case Some(build) => {
        if !saved(DOCS + "/previews/" + item.name + ".html", previewPage(item.name, build(), &blocks)) { failures = failures + 1 }
        if !saved(DOCS + "/" + folder + "/" + item.name + ".md", pageOf(&item, sourceOf(&program, item.name), &surface)) { failures = failures + 1 }
      }
    }
  }

  for folder in FOLDERS.entries() {
    let kind = folder[0]
    let items = registry.items.filter(|item: Item.Item| show(item.kind) == kind)

    if !saved(DOCS + "/" + folder[1] + "/toc.yml", tocOf(&items)) { failures = failures + 1 }
  }

  if !saved(DOCS + "/previews/home.html", previewPage("Home", demoHome(), &blocks).replace("min-block-size: 100vh; align-items: center; justify-content: center; padding: var(--fui-space-6)", "display: block")) { failures = failures + 1 }

  failures
}
