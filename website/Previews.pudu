/** @Website.Previews.Customer — a row of the example table */
type Customer = { name: Str, plan: Str, amount: Str }

/// Where the generated pages and previews go.
const DOCS: Str = "website/docs"

/// The docs folder each kind of item writes to.
const FOLDERS: Map[Str, Str] = mapOf([("Component", "components"), ("Element", "elements"), ("PageBlock", "blocks")])

/// A link that goes nowhere, for examples.
fn here(_number: Int) -> Str { "#" }

/// A sort link that goes nowhere, for examples.
fn sorted(_key: Str, _descending: Bool) -> Str { "#" }

/// A day link that goes nowhere, for examples.
fn dayLink(_day: Calendar.Date) -> Str { "#" }

/// A month link that goes nowhere, for examples.
fn monthLink(_year: Int, _month: Int) -> Str { "#" }

/// A column of examples with a constrained width.
fn column(width: Str, children: Array[H.Node]) -> H.Node {
  H.div().css("display", "flex").css("flex-direction", "column").css("gap", "var(--fui-space-4)").css("inline-size", width).holding(children)
}

/// The rows of the scroll area's demonstration, each over a line.
fn tagRows() -> Array[H.Node] {
  var rows: Array[H.Node] = []
  var version = 50

  while version > 0 {
    rows = rows.push(H.div().css("font-size", "var(--fui-text-sm)").says("v1.2.0-beta." + show(version))).push(Separator.separator(Separator.Horizontal).css("margin-block", "var(--fui-space-2)"))
    version = version - 1
  }

  rows
}

/// One row of the popover's demonstration.
fn sizeField(name: Str, caption: Str, value: Str) -> H.Node {
  H.div().css("display", "grid").css("grid-template-columns", "1fr 2fr").css("align-items", "center").css("gap", "var(--fui-space-4)").holding([Field.label(name).says(caption), Input.input(name, Input.props()).value(value)])
}

