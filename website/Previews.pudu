/// A padded card with the given children.
fn tile(children: Array[H.Node]) -> H.Node { Card.card().css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding(children) }

/// A navigation tile.
fn navTile(heading: Str, entries: &Array[(Icon.Glyph, Str)], active: Int) -> H.Node {
  var rows: Array[H.Node] = []
  var index = 0

  for entry in entries {
    rows = rows.push(Sidebar.menuItem().holding([Sidebar.menuButton("#", index == active).holding([Icon.icon(entry[0]), H.words(entry[1])])]))
    index = index + 1
  }

  Card.card().css("flex", "1").css("padding-block", "var(--fui-space-2)").holding([Sidebar.group().holding([Sidebar.groupLabel().says(heading), Sidebar.menu().holding(rows)])])
}

/// A card with a heading, a line under it, and its body.
fn headed(heading: Str, note: Str, body: Array[H.Node]) -> H.Node {
  tile([Card.header().holding([Card.title().says(heading), Card.description().says(note)]), Card.content().holding(body)])
}

/// Children spread along a row.
fn spread(children: Array[H.Node]) -> H.Node {
  H.div().css("display", "flex").css("align-items", "center").css("justify-content", "space-between").css("gap", "var(--fui-space-2)").holding(children)
}

/// Children one above another.
fn pile(children: Array[H.Node]) -> H.Node {
  H.div().css("display", "flex").css("flex-direction", "column").css("gap", "var(--fui-space-4)").holding(children)
}

/// A figure over its name, on a quiet surface.
fn figureBox(name: Str, value: Str) -> H.Node {
  H.div().css("flex", "1").css("padding", "var(--fui-space-3)").css("background", "color-mix(in oklab, var(--fui-muted) 60%, transparent)").css("border-radius", "var(--fui-radius-xl)").holding([
      H.div().css("font-size", "var(--fui-text-xs)").css("color", "var(--fui-muted-foreground)").says(name),
      H.div().css("font-size", "1.125rem").css("font-weight", "600").says(value)
    ])
}

/// A row of a team list.
fn memberRow(letters: Str, name: Str, role: Str) -> H.Node {
  Row.small(Row.Plain).holding([Row.media().holding([Avatar.initials(letters, name, Avatar.Medium)]), Row.content().holding([Row.title().says(name), Row.description().says(role)]), Row.actions().holding([Button.button(Button.props().variant(Button.Ghost).size(Button.IconSmall)).label("Options for " + name).holding([Icon.icon(Icon.More)])])])
}

/// A row of the releases table.
fn releaseRow(version: Str, date: Str, status: Badge.Variant, caption: Str) -> H.Node {
  Table.row().holding([Table.cell().css("font-weight", "500").says(version), Table.cell().says(date), Table.cell().css("text-align", "right").holding([Badge.badge(status).says(caption)])])
}

