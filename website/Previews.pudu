  [
    tile([Card.content().holding([pile([
                H.div().css("display", "flex").css("gap", "var(--fui-space-2)").holding([Button.button(Button.props()).holding([H.words("Publish"), Icon.icon(Icon.ArrowRight)]), Button.button(secondary).says("Preview"), Button.button(outline).says("Discard")]),
                InputGroup.group().holding([InputGroup.input("home-find").placeholder("Find a package"), InputGroup.addon(InputGroup.End).holding([Icon.icon(Icon.Search)])]),
                spread([H.div().css("display", "flex").css("gap", "var(--fui-space-2)").holding([Badge.badge(Badge.Primary).says("stable"), Badge.badge(Badge.Secondary).says("nightly")]), H.div().css("display", "flex").css("align-items", "center").css("gap", "var(--fui-space-2)").holding([RadioGroup.radio("home-r", "a", true), RadioGroup.radio("home-r", "b"), Checkbox.checkbox("home-c", Checkbox.props().checked()), Switch.switcher("home-s", true)])]),
                spread([Button.button(outline).says("Open log"), ButtonGroup.group(ButtonGroup.Horizontal).holding([Button.button(outline).says("Run tests"), Button.button(outline.size(Button.IconMedium)).label("More").holding([Icon.icon(Icon.ChevronDown)])])])
              ])])]),
    H.div().css("display", "flex").css("gap", "var(--fui-space-4)").css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding([
        navTile("Project", &[(Icon.File, "Sources"), (Icon.Folder, "Packages"), (Icon.Flag, "Releases"), (Icon.List, "Issues")], 1),
        navTile("Tools", &[(Icon.Terminal, "Shell"), (Icon.Wrench, "Builds"), (Icon.Book, "Guides"), (Icon.Settings, "Settings")], 9)
