/// A padded card with the given children.
fn tile(children: Array[H.Node]) -> H.Node { Card.card().css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding(children) }

/// A navigation tile.
fn navTile(heading: Str, entries: &Array[(Icon.Glyph, Str)], active: Int) -> H.Node {
  var rows: Array[H.Node] = []
  var index = 0

  for entry in entries {
    rows = rows.push(Sidebar.menuItem().holding([Sidebar.menuButton("#", index == active).holding([Icon.icon(entry[0]), H.words(entry[1])])]))
    index = index + 1
  }

  Card.card().css("flex", "1").css("padding-block", "var(--fui-space-2)").holding([Sidebar.group().holding([Sidebar.groupLabel().says(heading), Sidebar.menu().holding(rows)])])
}

/// The mosaic on the home page.
fn demoHome() -> H.Node {
  let outline = Button.props().variant(Button.Outline)
  let secondary = Button.props().variant(Button.Secondary)

  H.div().css("columns", "19rem").css("column-gap", "var(--fui-space-6)").css("padding", "var(--fui-space-6)").holding([
      tile([Card.content().css("display", "flex").css("flex-direction", "column").css("gap", "var(--fui-space-4)").holding([
              H.div().css("display", "flex").css("gap", "var(--fui-space-2)").holding([Button.button(Button.props()).holding([H.words("Button"), Icon.icon(Icon.ArrowRight)]), Button.button(secondary).says("Secondary"), Button.button(outline).says("Outline")]),
              InputGroup.group().holding([InputGroup.input("name").placeholder("Name"), InputGroup.addon(InputGroup.End).holding([Icon.icon(Icon.Search)])]),
              Textarea.textarea("message").placeholder("Message"),
              H.div().css("display", "flex").css("align-items", "center").css("gap", "var(--fui-space-2)").holding([Badge.badge(Badge.Primary).says("Badge"), Badge.badge(Badge.Secondary).says("Secondary"), H.div().css("flex", "1"), RadioGroup.radio("r", "a", true), RadioGroup.radio("r", "b"), Checkbox.checkbox("c", Checkbox.props().checked()), Switch.switcher("s", true)]),
              H.div().css("display", "flex").css("align-items", "center").css("justify-content", "space-between").css("gap", "var(--fui-space-2)").holding([Button.button(outline).says("Alert Dialog"), ButtonGroup.group(ButtonGroup.Horizontal).holding([Button.button(outline).says("Button Group"), Button.button(outline.size(Button.IconMedium)).label("More").holding([Icon.icon(Icon.ChevronUp)])])])
            ])]),
      H.div().css("display", "flex").css("gap", "var(--fui-space-4)").css("break-inside", "avoid").css("margin-block-end", "var(--fui-space-6)").holding([
          navTile("Workspace", &[(Icon.File, "Documents"), (Icon.Folder, "Projects"), (Icon.Calendar, "Calendar")], 9),
          navTile("Account", &[(Icon.User, "Profile"), (Icon.Settings, "Settings"), (Icon.Star, "Favorites")], 1)
        ]),
      tile([Card.header().holding([Card.title().says("Build history"), Card.description().says("Last five releases")]), Card.content().holding([Chart.labelled(Chart.Bars, "Builds", ["Jul", "Aug", "Sep", "Oct", "Nov"], [Chart.series("Builds", [4.0, 8.0, 6.0, 9.0, 5.0])])]), Card.footer().holding([Button.button(Button.props()).css("inline-size", "100%").says("View full report")])]),
      tile([Card.header().holding([Card.title().says("Plan a release"), Card.description().says("Pick a target and we will pace the work.")]), Card.content().holding([Field.group().holding([Field.field().holding([Field.label("goal").says("Release name"), Input.input("goal", Input.props()).placeholder("e.g. Spring update")]), Button.button(Button.props()).says("Create plan"), Button.button(outline).says("Cancel")])])]),
      tile([Empty.empty().holding([Empty.media().holding([Icon.icon(Icon.Plus)]), Empty.title().says("Publish a package"), Empty.description().says("Share your first release with everyone using Pudu."), Empty.content().holding([Button.button(Button.props()).says("Create release")])])]),
      tile([Card.header().holding([Card.title().says("Traffic"), Card.description().says("418,200 visitors"), Card.action().holding([Button.button(Button.props().variant(Button.Outline).size(Button.Small)).says("View")])]), Card.content().holding([Chart.chart(Chart.Areas, "Visits", [Chart.series("Visits", [4.0, 7.0, 5.0, 3.0, 6.0, 6.0])])])]),
      tile([Card.header().holding([Card.title().says("Notifications"), Card.description().says("Choose what reaches you.")]), Card.content().holding([Field.group().holding([
                  Field.oriented(Field.Horizontal, false).holding([Checkbox.checkbox("n1", Checkbox.props().checked()), Field.content().holding([Field.title().says("Build alerts"), Field.description().says("Failures and recoveries.")])]),
                  Field.oriented(Field.Horizontal, false).holding([Checkbox.checkbox("n2", Checkbox.props().checked()), Field.content().holding([Field.title().says("Security alerts"), Field.description().says("Sign-ins and account changes.")])])
                ])])])
    ])
}

/// Writes a file, reporting a failure on the error stream.
fn saved(path: Str, text: Str) -> Bool {
  let _made = Io.makeDirectory(Path.directoryOf(path))

  match Io.write(path, text) {
    case Ok(_) => true
    case Err(problem) => {
      let _said = Io.writeErrorLine(path + ": " + problem)

      false
    }
  }
}

/// A standalone preview page holding one demonstration.
fn previewPage(title: Str, look: Str, body: H.Node, blocks: &Array[Css.Block]) -> Str {
  Fui.document(&Fui.page(title, Theme.defaults().look([]), *blocks).inHead([lookLink(look)]), H.main().css("display", "flex").css("min-block-size", "100vh").css("align-items", "center").css("justify-content", "center").css("padding", "var(--fui-space-6)").holding([body]))
}

/// The text between a demonstration's signature and its end.
fn sourceOf(program: &Array[Str], name: Str) -> Str {
  let signature = "fn demo" + Spelling.pascal(name) + "() -> H.Node"
  var collected: Array[Str] = []
  var inside = false

  for text in program {
    if inside && text == "\}" { return collected.join("\n") }
    if inside { collected = collected.push(text.drop(2)) }
    if text.startsWith(signature) {
      if text.endsWith("\}") { return text.drop(signature.length() + 3).take(text.length() - signature.length() - 5) }

      inside = true
    }
  }

  collected.join("\n")
}

/// A description as a sentence.
fn sentence(text: Str) -> Str { text.take(1).toUpper() + text.drop(1) + "." }

/// An item's name as a title: words capitalized and spaced.
fn titled(name: Str) -> Str { name.split("-").map(|word: Str| Spelling.pascal(word)).join(" ") }

/// One item's documentation page.
fn pageOf(item: &Item.Item, source: Str, surface: &Array[Str]) -> Str {
  let title = titled(item.name)

  ["---", "title: " + title, "description: " + sentence(item.description), "---", "", "# " + title, "", sentence(item.description), "",
    "<div class=\"fui-preview\"><a href=\"../previews/" + item.name + ".html\">Open the " + title + " preview</a></div>", "",
    "## Installation", "", "```bash", "fui add " + item.name, "```", "",
    "## Usage", "", "```pudu", source, "```", "",
    "## API", "", "```pudu", surface.join("\n"), "```", ""].join("\n")
}

/// Exported signatures of a source, one declaration per line.
fn surfaceOf(source: Str) -> Array[Str] {
  source.split("\n").filter(|text: Str| text.startsWith("export ")).map(|text: Str| text.split(" \{ Core")[0].split(" \{ Button")[0].split(" \{ H.")[0].split(" \{ Props")[0].replace(" \{", ""))
}

/// A table of contents for one kind of item.
fn tocOf(items: &Array[Item.Item]) -> Str {
  var lines: Array[Str] = []

  for item in items {
    lines = lines.push("- name: " + titled(item.name)).push("  href: " + item.name + ".md")
  }

  lines.join("\n") + "\n"
}

/// The look the reference pages show; the home page shows the default look.
const DOCS_LOOK: Str = "classic"

/// The stylesheet a preview's look comes from; the Create page swaps it.
fn lookLink(name: Str) -> H.Node { H.tag("link").at("rel", "stylesheet").id("fui-look").href("looks/" + name + ".css") }

/// A list of text as JSON.
fn textList(values: &Array[Str]) -> Json.Json { Json.list(&values.map(|value: Str| Json.Text(value))) }

/// The rules a menu choice adds, as a stylesheet.
fn menuSheet(rules: &Array[Css.LookRule]) -> Json.Json { Json.Text(if rules.isEmpty() { "" } else { Css.renderLook(rules, &setOf([]), true) }) }

/// Each named choice beside the sheet it adds.
fn sheets(names: &Array[Str], build: fn(Str) -> Array[Css.LookRule]) -> Json.Json {
  Json.object(&names.map(|name: Str| {
        let rules = build(name)

        (name, menuSheet(&rules))
      }))
}

/// A palette as JSON.
fn swatchJson(name: Str) -> (Str, Json.Json) {
  let rows = Option.unwrapOr(Swatches.SWATCHES.get(name), [])

  (name, Json.list(&rows.map(|row: (Str, Str, Str)| textList(&[row[0], row[1], row[2]]))))
}

/// Everything the Create page offers.
fn createData(items: &Array[Str]) -> Str {
  let colors = Options.BASE_COLORS.concat(Options.ACCENT_COLORS)

  Json.encodePretty(&Json.object(&[
        ("code", Json.Text(Design.encode(&Design.initial()))),
        ("looks", textList(&Looks.names())),
        ("bases", textList(&Options.BASE_COLORS)),
        ("accents", textList(&Options.ACCENT_COLORS)),
        ("swatches", Json.object(&colors.map(|name: Str| swatchJson(name)))),
        ("fonts", Json.list(&Options.FONTS.map(|font: (Str, Str, Str)| textList(&[font[0], font[1], font[2]])))),
        ("radii", Json.list(&Options.RADII.map(|radius: (Str, Str)| textList(&[radius[0], radius[1]])))),
        ("menus", sheets(&Options.MENU_COLORS, Design.menuColorRules)),
        ("menuAccents", sheets(&Options.MENU_ACCENTS, Design.menuAccentRules)),
        ("libraries", Json.list(&Options.ICON_LIBRARIES.map(|library: (Str, Str, Str)| textList(&[library[0], library[1], library[2]])))),
        ("iconNames", Json.object(&Options.ICON_NAMES.map(|entry: (Str, Array[Str])| (entry[0], textList(&entry[1]))))),
        ("iconService", Json.Text(Constant.ICON_SERVICE)),
        ("items", textList(items))
      ])) + "\n"
}

/// Writes each look's stylesheet and the Create page's data; answers how many failed.
fn writeCreateAssets(items: &Array[Str]) -> Int {
  var failures = 0

  for name in Looks.names() {
    let rules = Option.unwrapOr(Looks.named(name), [])

    if !saved(DOCS + "/previews/looks/" + name + ".css", Css.renderLook(&rules, &setOf([]), true) + "\n") { failures = failures + 1 }
  }

  if !saved(DOCS + "/previews/create.json", createData(items)) { failures = failures + 1 }

  failures
}

/// Writes every preview and page; answers the number of problems.
fn main() -> Int {
  let registry = match Registry.load(".") {
    case Ok(found) => found
    case Err(problem) => panic(problem)
  }
  let program = Result.unwrapOr(Io.read("website/Previews.pudu"), "").split("\n")
  let blocks = Catalog.all()
  var failures = 0

  for item in registry.items {
    let folder = Option.unwrapOr(FOLDERS.get(show(item.kind)), "components")
    let surface = surfaceOf(Result.unwrapOr(Io.read(item.path), ""))

    match DEMOS.get(item.name) {
      case None => {
        let _said = Io.writeErrorLine("no demonstration for " + item.name)

        failures = failures + 1
      }
      case Some(build) => {
        if !saved(DOCS + "/previews/" + item.name + ".html", previewPage(item.name, DOCS_LOOK, build(), &blocks)) { failures = failures + 1 }
        if !saved(DOCS + "/" + folder + "/" + item.name + ".md", pageOf(&item, sourceOf(&program, item.name), &surface)) { failures = failures + 1 }
      }
    }
  }

  for folder in FOLDERS.entries() {
    let kind = folder[0]
    let items = registry.items.filter(|item: Item.Item| show(item.kind) == kind)

    if !saved(DOCS + "/" + folder[1] + "/toc.yml", tocOf(&items)) { failures = failures + 1 }
  }

  failures = failures + writeCreateAssets(&registry.items.map(|item: Item.Item| item.name))

  if !saved(DOCS + "/previews/home.html", previewPage("Home", Looks.DEFAULT, demoHome(), &blocks).replace("min-block-size: 100vh; align-items: center; justify-content: center; padding: var(--fui-space-6)", "display: block")) { failures = failures + 1 }

  failures
}
