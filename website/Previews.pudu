/// A sign-in card reading the given words in order.
fn loginCard(words: Array[Str]) -> H.Node {
  Card.sized(Card.Regular).css("inline-size", "24rem").holding([
      Card.header().holding([Card.title().says(words[0]), Card.description().says(words[1]), Card.action().holding([Button.button(Button.props().variant(Button.Plain)).says(words[2])])]),
      Card.content().holding([Field.group().holding([
              Field.field().holding([Field.label("card-email").says(words[3]), Input.input("card-email", Input.props().kind("email")).placeholder("m@example.com")]),
              Field.field().holding([H.div().css("display", "flex").css("justify-content", "space-between").holding([Field.label("card-password").says(words[4]), H.a().href("#").css("font-size", "var(--fui-text-sm)").css("color", "inherit").css("text-decoration", "none").says(words[5])]), Input.input("card-password", Input.props().kind("password"))])
            ])]),
      Card.footer().css("flex-direction", "column").css("gap", "var(--fui-space-2)").holding([Button.button(Button.props()).css("inline-size", "100%").says(words[6]), Button.button(Button.props().variant(Button.Outline)).css("inline-size", "100%").says(words[7])])
    ])
}

fn demoCard() -> H.Node { loginCard(["Login to your account", "Enter your email below to login to your account", "Sign Up", "Email", "Password", "Forgot your password?", "Login", "Login with Google"]) }

