{
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "previews/**"
        ],
        "src": "docs"
      }
    ],
    "resource": [
      {
        "files": [
          "previews/**"
        ],
        "src": "docs"
      },
      {
        "files": [
          "favicon.png",
          "logo.png"
        ],
        "src": "template/public"
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "template"
    ],
    "globalMetadata": {
      "_appTitle": "Foundation UI",
      "_appName": "Foundation UI",
      "_appScript": "public/main.js",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "en",
      "_themeColor": "#4f6ef7",
      "_copyright": "Chris M. Perez Santiago",
      "description": "A component system for Pudu: typed props, source you own, and a theme built from seven design aspects.",
      "_footerLinks": [
        {
          "name": "Source",
          "href": "https://github.com/chrismichaelps/pudu-lang-fui"
        },
        {
          "name": "Issues",
          "href": "https://github.com/chrismichaelps/pudu-lang-fui/issues"
        },
        {
          "name": "Pudu",
          "href": "https://www.pudu-lang.org/"
        }
      ],
      "_appFaviconPath": "favicon.png",
      "_appLogoPath": "logo.png"
    }
  }
}
